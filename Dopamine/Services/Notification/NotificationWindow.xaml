<Window x:Class="Dopamine.Services.Notification.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Dopamine.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mybase="clr-namespace:Dopamine.Core.Base;assembly=Dopamine.Core"
        xmlns:views="clr-namespace:Dopamine.Views"
        x:Name="Me"
        Width="0"
        Height="0"
        AllowsTransparency="True"
        Background="Transparent"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None"
        mc:Ignorable="d">

    <!--  Resources  -->
    <Window.Resources>
        <Storyboard x:Key="ShowCoverControls">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetName="CoverControls"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
        <Storyboard x:Key="HideCoverControls">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetName="CoverControls"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1"
                                 To="0"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
    </Window.Resources>

    <Border Margin="10"
            Background="{DynamicResource Brush_WindowHeaderBackground}"
            BorderThickness="0"
            Opacity="0"
            RenderTransformOrigin="0,1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10"
                              Opacity="0.5"
                              ShadowDepth="0"
                              Color="Black" />
        </Border.Effect>
        <!--  Content  -->
        <Grid>
            <DockPanel>
                <Grid DockPanel.Dock="Right">
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Grid.MouseEnter">
                            <BeginStoryboard Storyboard="{StaticResource ShowCoverControls}" />
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Grid.MouseLeave">
                            <BeginStoryboard Storyboard="{StaticResource HideCoverControls}" />
                        </EventTrigger>
                    </Grid.Triggers>
                    <controls:Tile x:Name="CoverTile"
                                   Width="{Binding ActualHeight, ElementName=Me}"
                                   Height="{Binding ActualHeight, ElementName=Me}"
                                   Panel.ZIndex="0"
                                   Background="{DynamicResource Brush_CoverTileBackground}"
                                   IconSizePercent="{x:Static mybase:Constants.HeadPhoneSmallSize}">
                        <controls:Tile.Content>
                            <Viewbox>
                                <Path Data="{DynamicResource HeadPhone}" Fill="{DynamicResource Brush_CoverTileIcon}" />
                            </Viewbox>
                        </controls:Tile.Content>
                    </controls:Tile>
                    <Image x:Name="CoverPicture"
                           Panel.ZIndex="1"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Grid x:Name="CoverControls"
                          Panel.ZIndex="2"
                          Opacity="0">
                        <Border x:Name="CloseBorder"
                                Height="30"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Brush_TopBlackBottomTransparent}" />
                        <Button x:Name="CloseButton"
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{x:Null}"
                                BorderBrush="{x:Null}"
                                BorderThickness="0"
                                Click="CloseButton_Click"
                                Style="{StaticResource WindowButton}"
                                ToolTip="{DynamicResource Language_Close}">
                            <Path HorizontalAlignment="center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource Close}"
                                  Fill="White" />
                        </Button>
                    </Grid>
                </Grid>
                <DockPanel Margin="10">
                    <views:VerticalVolumeControls x:Name="VolumePanel"
                                                  Width="30"
                                                  Margin="0,0,10,0"
                                                  DockPanel.Dock="Left" />
                    <DockPanel>
                        <StackPanel Margin="5,0,5,0"
                                    HorizontalAlignment="Left"
                                    DockPanel.Dock="Top">
                            <TextBlock x:Name="TextBoxTitle"
                                       FontSize="22"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource Brush_PrimaryText}"
                                       TextAlignment="Left"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TextBoxArtist"
                                       Foreground="{DynamicResource Brush_Accent}"
                                       TextAlignment="Left"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel.ToolTip>
                                <ToolTip>
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock x:Name="ToolTipTitle" FontWeight="Bold" />
                                        <TextBlock x:Name="ToolTipArtist" />
                                    </StackPanel>
                                </ToolTip>
                            </StackPanel.ToolTip>
                        </StackPanel>
                        <views:PlaybackControls x:Name="ControlsPanel"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                SnapsToDevicePixels="True"
                                                UseLayoutRounding="True" />
                    </DockPanel>
                </DockPanel>
            </DockPanel>
        </Grid>

        <!--  Animation  -->
        <Border.Style>
            <Style>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsEnabled, ElementName=Me}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.1" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.26" Storyboard.TargetProperty="(UIElement.Opacity)">
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
</Window>
