<baseviews:MiniPlayerViewBase x:Class="Dopamine.Views.MiniPlayer.NanoPlayer"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:baseviews="clr-namespace:Dopamine.Views.Common.Base"
                              xmlns:commonviews="clr-namespace:Dopamine.Views.Common"
                              xmlns:corebase="clr-namespace:Dopamine.Core.Base;assembly=Dopamine.Core"
                              xmlns:cp="clr-namespace:Dopamine.Core.Prism;assembly=Dopamine.Core"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
                              xmlns:utils="clr-namespace:Dopamine.Utils"
                              d:DesignHeight="300"
                              d:DesignWidth="300"
                              prismMvvm:ViewModelLocator.AutoWireViewModel="True"
                              Background="{DynamicResource Brush_WindowHeaderBackground}"
                              mc:Ignorable="d">

    <baseviews:MiniPlayerViewBase.Resources>
        <CollectionViewSource x:Key="PlaylistsDataSource" Source="{Binding DataContext.ContextMenuPlaylists, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
        <Storyboard x:Key="FadeIn">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.5"
                                 To="1"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1"
                                 To="0.5"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
        <Storyboard x:Key="ShowPlaybackInfoControls">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetName="PlaybackInfoControls"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
        <Storyboard x:Key="HidePlaybackInfoControls">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetName="PlaybackInfoControls"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1"
                                 To="0"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
    </baseviews:MiniPlayerViewBase.Resources>

    <baseviews:MiniPlayerViewBase.ContextMenu>
        <ContextMenu>
            <ContextMenu.Resources>
                <utils:BindingProxy x:Key="NewPlaylistProxy" Data="{DynamicResource Language_New_Playlist}" />
            </ContextMenu.Resources>
            <MenuItem Command="{x:Static cp:ApplicationCommands.ToggleMiniPlayerAlwaysOnTopCommand}"
                      Header="{DynamicResource Language_Always_On_Top}"
                      InputGestureText=""
                      IsCheckable="True"
                      IsChecked="{Binding IsMiniPlayerAlwaysOnTop, Mode=OneWay}" />
            <MenuItem Command="{x:Static cp:ApplicationCommands.ToggleMiniPlayerPositionLockedCommand}"
                      Header="{DynamicResource Language_Lock_Position}"
                      InputGestureText=""
                      IsCheckable="True"
                      IsChecked="{Binding IsMiniPlayerPositionLocked, Mode=OneWay}" />
            <Separator />
            <MenuItem Command="{x:Static cp:ApplicationCommands.ChangePlayerTypeCommand}"
                      CommandParameter="1"
                      Header="{DynamicResource Language_Cover_Player}"
                      InputGestureText=""
                      IsCheckable="True"
                      IsChecked="{Binding IsCoverPlayerChecked, Mode=OneWay}" />
            <MenuItem Command="{x:Static cp:ApplicationCommands.ChangePlayerTypeCommand}"
                      CommandParameter="2"
                      Header="{DynamicResource Language_Micro_Player}"
                      InputGestureText=""
                      IsCheckable="True"
                      IsChecked="{Binding IsMicroPlayerChecked, Mode=OneWay}" />
            <MenuItem Command="{x:Static cp:ApplicationCommands.ChangePlayerTypeCommand}"
                      CommandParameter="3"
                      Header="{DynamicResource Language_Nano_Player}"
                      InputGestureText=""
                      IsCheckable="True"
                      IsChecked="{Binding IsNanoPlayerChecked, Mode=OneWay}" />
            <Separator />
            <MenuItem DisplayMemberPath="Name" Header="{DynamicResource Language_Add_To_Playlist}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Command" Value="{Binding DataContext.AddPlayingTrackToPlaylistCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                        <Setter Property="CommandParameter" Value="{Binding Name}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
                <MenuItem.ItemsSource>
                    <CompositeCollection>
                        <MenuItem Header="{Binding Source={StaticResource NewPlaylistProxy}, Path=Data, Converter={StaticResource AddEllipsisConverter}}" />
                        <Separator />
                        <CollectionContainer Collection="{Binding Source={StaticResource PlaylistsDataSource}}" />
                    </CompositeCollection>
                </MenuItem.ItemsSource>
                <MenuItem.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </MenuItem.ItemsPanel>
                <MenuItem.Template>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <MenuItem DisplayMemberPath="Name" Header="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                                <MenuItem.ItemsSource>
                                    <CompositeCollection>
                                        <Separator />
                                    </CompositeCollection>
                                </MenuItem.ItemsSource>
                            </MenuItem>
                            <Popup AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Right"
                                   PopupAnimation="Fade">
                                <Border Background="White"
                                        BorderBrush="Transparent"
                                        BorderThickness="8,10,5,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                                          Opacity="0.6"
                                                          ShadowDepth="0" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
        </ContextMenu>
    </baseviews:MiniPlayerViewBase.ContextMenu>

    <Grid x:Name="PlayerPanel"
          Width="{x:Static corebase:Constants.NanoPlayerWidth}"
          Height="{x:Static corebase:Constants.NanoPlayerHeight}">
        <StackPanel Height="44"
                    VerticalAlignment="Top"
                    Panel.ZIndex="0"
                    Orientation="Horizontal">
            <commonviews:NanoPlayerControls Margin="10,1,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center" />
            <Grid>
                <!--  PlaybackInfo controls  -->
                <DockPanel x:Name="PlaybackInfoControls"
                           VerticalAlignment="Top"
                           Panel.ZIndex="1"
                           Opacity="0">
                    <Grid>
                        <Border Width="66"
                                Height="44"
                                HorizontalAlignment="Right"
                                Panel.ZIndex="0"
                                Background="{DynamicResource Brush_NanoPlayerWindowControlsBackground}" />
                        <commonviews:WindowControls HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Panel.ZIndex="1"
                                                    ButtonHeight="22"
                                                    ButtonWidth="22"
                                                    EnableHighContrast="False" />
                    </Grid>
                </DockPanel>
                <commonviews:PlaybackInfoControlNano Width="220"
                                                     Margin="15,0,15,0"
                                                     HorizontalAlignment="Left"
                                                     Panel.ZIndex="0" />
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Grid.MouseEnter">
                        <BeginStoryboard Storyboard="{StaticResource ShowPlaybackInfoControls}" />
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Grid.MouseLeave">
                        <BeginStoryboard Storyboard="{StaticResource HidePlaybackInfoControls}" />
                    </EventTrigger>
                </Grid.Triggers>
            </Grid>
        </StackPanel>
        <commonviews:ProgressControlsThin Height="16"
                                          Margin="0"
                                          VerticalAlignment="Bottom"
                                          Panel.ZIndex="1"
                                          DockPanel.Dock="Bottom" />
    </Grid>
</baseviews:MiniPlayerViewBase>
