<UserControl x:Class="Dopamine.Views.Common.FileInformation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="False"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Dopamine;component/Resources/Styles/AllStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,20,20,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  SONG  -->
        <Label Grid.Row="0"
               Grid.ColumnSpan="2"
               Margin="0,0,0,5"
               Content="{DynamicResource Language_Song}"
               Style="{StaticResource TitleLabel}" />
        <!--  Title  -->
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Title}" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding SongTitle}"
                   TextTrimming="CharacterEllipsis" />
        <!--  Artists  -->
        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Artists}" />
        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding SongArtists}"
                   TextTrimming="CharacterEllipsis" />
        <!--  Album  -->
        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Album}" />
        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding SongAlbum}"
                   TextTrimming="CharacterEllipsis" />
        <!--  Year  -->
        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Year}" />
        <TextBlock Grid.Row="4"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding SongYear}"
                   TextTrimming="CharacterEllipsis" />
        <!--  Genres  -->
        <TextBlock Grid.Row="5"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Genres}" />
        <TextBlock Grid.Row="5"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding SongGenres}"
                   TextTrimming="CharacterEllipsis" />
        <!--  Track number  -->
        <TextBlock Grid.Row="6"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Track_Number}" />
        <TextBlock Grid.Row="6"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding SongTrackNumber}"
                   TextTrimming="CharacterEllipsis" />
        <!--  FILE  -->
        <Label Grid.Row="7"
               Grid.ColumnSpan="2"
               Margin="0,20,0,5"
               Content="{DynamicResource Language_File}"
               Style="{StaticResource TitleLabel}" />
        <!--  Name  -->
        <TextBlock Grid.Row="8"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Name}" />
        <TextBlock Grid.Row="8"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding FileName}"
                   TextTrimming="CharacterEllipsis" />
        <!--  Folder  -->
        <TextBlock Grid.Row="9"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Folder}" />
        <TextBlock Grid.Row="9"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding FileFolder}"
                   TextTrimming="CharacterEllipsis" />
        <!--  Path  -->
        <TextBlock Grid.Row="10"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Path}" />
        <TextBlock Grid.Row="10"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding FilePath}"
                   TextTrimming="CharacterEllipsis" />
        <!--  Size  -->
        <TextBlock Grid.Row="11"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Size}" />
        <TextBlock Grid.Row="11"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding FileSize}"
                   TextTrimming="CharacterEllipsis" />
        <!--  Last modified  -->
        <TextBlock Grid.Row="12"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Last_Modified}" />
        <TextBlock Grid.Row="12"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding FileLastModified}"
                   TextTrimming="CharacterEllipsis" />
        <!--  AUDIO  -->
        <Label Grid.Row="13"
               Grid.ColumnSpan="2"
               Margin="0,20,0,5"
               Content="{DynamicResource Language_Audio}"
               Style="{StaticResource TitleLabel}" />
        <!--  Duration  -->
        <TextBlock Grid.Row="14"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Duration}" />
        <TextBlock Grid.Row="14"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding AudioDuration}"
                   TextTrimming="CharacterEllipsis" />
        <!--  Type  -->
        <TextBlock Grid.Row="15"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Type}" />
        <TextBlock Grid.Row="15"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding AudioType}"
                   TextTrimming="CharacterEllipsis" />
        <!--  Sample rate  -->
        <TextBlock Grid.Row="16"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Sample_Rate}" />
        <TextBlock Grid.Row="16"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding AudioSampleRate}"
                   TextTrimming="CharacterEllipsis" />
        <!--  Bitrate  -->
        <TextBlock Grid.Row="17"
                   Grid.Column="0"
                   Margin="0,5,10,0"
                   Foreground="{DynamicResource Brush_SecondaryText}"
                   Text="{DynamicResource Language_Bitrate}" />
        <TextBlock Grid.Row="17"
                   Grid.Column="1"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{Binding AudioBitrate}"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
