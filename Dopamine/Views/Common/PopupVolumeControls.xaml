<baseviews:VolumeControlViewBase x:Class="Dopamine.Views.Common.PopupVolumeControls"
                                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                 xmlns:baseviews="clr-namespace:Dopamine.Views.Base"
                                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                 xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
                                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                 xmlns:pc="clr-namespace:Dopamine.Controls"
                                 xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
                                 x:Name="ThisControl"
                                 prismMvvm:ViewModelLocator.AutoWireViewModel="True"
                                 mc:Ignorable="d">

    <Grid PreviewMouseWheel="Grid_PreviewMouseWheel">
        <Button x:Name="VolumeButton"
                Width="{Binding Width, ElementName=ThisControl}"
                Height="{Binding Height, ElementName=ThisControl}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="VolumeButton_Click"
                IsHitTestVisible="{Binding IsOpen, ElementName=VolumeButtonPopup, Converter={StaticResource InvertingBooleanConverter}}"
                Style="{StaticResource TransparentButton}">
            <Grid>
                <TextBlock FontSize="16"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Style="{StaticResource SegoeAssets}"
                           Text="&#xE767;"
                           Visibility="{Binding Mute, Converter={StaticResource InvertingBooleanToVisibilityConverter}}" />
                <TextBlock FontSize="16"
                           Foreground="{DynamicResource Brush_Accent}"
                           Style="{StaticResource SegoeAssets}"
                           Text="&#xE74F;"
                           Visibility="{Binding Mute, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Button>
        <pc:PopupEx x:Name="VolumeButtonPopup"
                    Width="40"
                    Height="130"
                    AllowsTransparency="True"
                    HorizontalOffset="-7"
                    Placement="Top"
                    PlacementTarget="{Binding ElementName=VolumeButton}"
                    PopupAnimation="Fade"
                    StaysOpen="False"
                    VerticalOffset="-5">
            <Grid>
                <!--  Fake shadow  -->
                <Border Panel.ZIndex="0"
                        Background="Gray"
                        Opacity="0.05" />
                <Border Margin="1"
                        Panel.ZIndex="1"
                        Background="Gray"
                        Opacity="0.1" />
                <Border Margin="2"
                        Panel.ZIndex="2"
                        Background="Gray"
                        Opacity="0.15" />
                <Border Margin="3"
                        Panel.ZIndex="3"
                        Background="{DynamicResource Brush_WindowHeaderBackground}"
                        MouseEnter="Border_MouseEnter"
                        MouseLeave="Border_MouseLeave">
                    <StackPanel>
                        <!--  Mute and unmute  -->
                        <Grid Margin="0,3,0,0" HorizontalAlignment="Center">
                            <!--  Mute  -->
                            <Button x:Name="MuteButton"
                                    Width="30"
                                    Height="30"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding MuteCommand}"
                                    Style="{StaticResource TransparentButton}"
                                    ToolTip="{DynamicResource Language_Mute}"
                                    Visibility="{Binding Mute, Converter={StaticResource InvertingBooleanToVisibilityConverter}}">
                                <TextBlock FontSize="16"
                                           Foreground="{DynamicResource Brush_PrimaryText}"
                                           Style="{StaticResource SegoeAssets}"
                                           Text="&#xE767;" />
                            </Button>
                            <!--  Unmute  -->
                            <Button x:Name="UnmuteButton"
                                    Width="30"
                                    Height="30"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding UnmuteCommand}"
                                    Style="{StaticResource TransparentButton}"
                                    ToolTip="{DynamicResource Language_Unmute}"
                                    Visibility="{Binding Mute, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="16"
                                           Foreground="{DynamicResource Brush_Accent}"
                                           Style="{StaticResource SegoeAssets}"
                                           Text="&#xE74F;" />
                            </Button>
                        </Grid>
                        <dc:UWPSliderVertical Height="50"
                                              Margin="0,5,0,10"
                                              HorizontalAlignment="Center"
                                              BarBackground="{DynamicResource Brush_Accent}"
                                              ButtonBackground="{DynamicResource Brush_PrimaryText}"
                                              ButtonInnerBackground="{DynamicResource Brush_WindowHeaderBackground}"
                                              ChangeValueWhileDragging="True"
                                              Maximum="1"
                                              TrackBackground="{DynamicResource Brush_SliderBackground}"
                                              Value="{Binding VolumeValue, Mode=TwoWay}" />
                        <Label Padding="0"
                               HorizontalContentAlignment="Center"
                               Content="{Binding VolumeValuePercent}"
                               FontSize="12"
                               Foreground="{DynamicResource Brush_PrimaryText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </pc:PopupEx>
    </Grid>
</baseviews:VolumeControlViewBase>
