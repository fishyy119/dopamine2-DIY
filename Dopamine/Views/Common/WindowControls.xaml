<UserControl x:Class="Dopamine.Views.Common.WindowControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="clr-namespace:Dopamine.Core.Prism;assembly=Dopamine.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Me"
             d:DesignHeight="300"
             d:DesignWidth="300"
             mc:Ignorable="d">

    <StackPanel Orientation="Horizontal">
        <Button x:Name="PART_TogglePlayer"
                Width="{Binding ButtonWidth, ElementName=Me}"
                Height="{Binding ButtonHeight, ElementName=Me}"
                Background="{x:Null}"
                BorderBrush="{x:Null}"
                BorderThickness="0"
                Command="{x:Static cp:ApplicationCommands.TogglePlayerCommand}"
                ToolTip="{DynamicResource Language_Switch_Player}">
            <Path HorizontalAlignment="center"
                  VerticalAlignment="Center"
                  Data="{StaticResource MiniPlayer}"
                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="False" />
        </Button>
        <Button x:Name="PART_Minimize"
                Width="{Binding ButtonWidth, ElementName=Me}"
                Height="{Binding ButtonHeight, ElementName=Me}"
                Background="{x:Null}"
                BorderBrush="{x:Null}"
                BorderThickness="0"
                Command="{x:Static cp:ApplicationCommands.MinimizeWindowCommand}"
                ToolTip="{DynamicResource Language_Minimize}">
            <Path HorizontalAlignment="center"
                  VerticalAlignment="Center"
                  Data="{StaticResource Minimize}"
                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="False" />
        </Button>
        <Grid Visibility="{Binding ShowMaximizeRestoreButton, ElementName=Me, Converter={StaticResource BooleanToCollapsedConverter}}">
            <Button x:Name="PART_Maximize"
                    Width="{Binding ButtonWidth, ElementName=Me}"
                    Height="{Binding ButtonHeight, ElementName=Me}"
                    Background="{x:Null}"
                    BorderBrush="{x:Null}"
                    BorderThickness="0"
                    Command="{x:Static cp:ApplicationCommands.MaximizeRestoreWindowCommand}"
                    ToolTip="{DynamicResource Language_Maximize}"
                    Visibility="Visible">
                <Path HorizontalAlignment="center"
                      VerticalAlignment="Center"
                      Data="{StaticResource Maximize}"
                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="False" />
            </Button>
            <Button x:Name="PART_Restore"
                    Width="{Binding ButtonWidth, ElementName=Me}"
                    Height="{Binding ButtonHeight, ElementName=Me}"
                    Background="{x:Null}"
                    BorderBrush="{x:Null}"
                    BorderThickness="0"
                    Command="{x:Static cp:ApplicationCommands.MaximizeRestoreWindowCommand}"
                    ToolTip="{DynamicResource Language_Restore}"
                    Visibility="Collapsed">
                <Path HorizontalAlignment="center"
                      VerticalAlignment="Center"
                      Data="{StaticResource Restore}"
                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="False" />
            </Button>
        </Grid>
        <Button x:Name="PART_Close"
                Width="{Binding ButtonWidth, ElementName=Me}"
                Height="{Binding ButtonHeight, ElementName=Me}"
                Background="{x:Null}"
                BorderBrush="{x:Null}"
                BorderThickness="0"
                Command="{x:Static cp:ApplicationCommands.CloseWindowCommand}"
                ToolTip="{DynamicResource Language_Close}">
            <Path HorizontalAlignment="center"
                  VerticalAlignment="Center"
                  Data="{StaticResource Close}"
                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="False" />
        </Button>
    </StackPanel>
</UserControl>
