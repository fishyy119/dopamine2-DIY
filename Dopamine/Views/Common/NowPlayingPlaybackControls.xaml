<UserControl x:Class="Dopamine.Views.Common.NowPlayingPlaybackControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:commonviews="clr-namespace:Dopamine.Views.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:enums="clr-namespace:Dopamine.Core.Enums;assembly=Dopamine.Core"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             xmlns:pv="clr-namespace:Dopamine.Views"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <DockPanel Height="80">
        <!--  Progress slider  -->
        <commonviews:ProgressControls DockPanel.Dock="Top" />
        <Grid Margin="0,-6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  Buttons  -->
            <dc:Pivot Grid.Column="0"
                      Margin="25,0,0,0"
                      VerticalAlignment="Center"
                      SelectedIndex="{Binding SelectedNowPlayingSubPage, Converter={StaticResource EnumConverter}, ConverterParameter={x:Type enums:NowPlayingSubPage}}"
                      Visibility="{Binding HasPlaybackQueue, Converter={StaticResource BooleanToCollapsedConverter}}">
                <!--  Showcase button  -->
                <dc:PivotItem HeaderForeground="{DynamicResource Brush_PrimaryText}" SelectedHeaderForeground="{DynamicResource Brush_Accent}">
                    <dc:PivotItem.HeaderTemplate>
                        <DataTemplate>
                            <Border ToolTip="{DynamicResource Language_Showcase}">
                                <TextBlock Margin="6,0,6,0"
                                           FontSize="16"
                                           Style="{StaticResource SegoeAssets}"
                                           Text="&#xEA69;" />
                            </Border>
                        </DataTemplate>
                    </dc:PivotItem.HeaderTemplate>
                </dc:PivotItem>
                <!--  Playlist button  -->
                <dc:PivotItem HeaderForeground="{DynamicResource Brush_PrimaryText}" SelectedHeaderForeground="{DynamicResource Brush_Accent}">
                    <dc:PivotItem.HeaderTemplate>
                        <DataTemplate>
                            <Border ToolTip="{DynamicResource Language_Playlist}">
                                <TextBlock Margin="6,0,6,0"
                                           FontSize="16"
                                           Style="{StaticResource SegoeAssets}"
                                           Text="&#xEA37;" />
                            </Border>
                        </DataTemplate>
                    </dc:PivotItem.HeaderTemplate>
                </dc:PivotItem>
                <!--  Lyrics button  -->
                <dc:PivotItem HeaderForeground="{DynamicResource Brush_PrimaryText}" SelectedHeaderForeground="{DynamicResource Brush_Accent}">
                    <dc:PivotItem.HeaderTemplate>
                        <DataTemplate>
                            <Border ToolTip="{DynamicResource Language_Lyrics}">
                                <TextBlock Margin="6,0,6,0"
                                           FontSize="16"
                                           Style="{StaticResource SegoeAssets}"
                                           Text="&#xE720;" />
                            </Border>
                        </DataTemplate>
                    </dc:PivotItem.HeaderTemplate>
                </dc:PivotItem>
                <!--  Artist information button  -->
                <dc:PivotItem HeaderForeground="{DynamicResource Brush_PrimaryText}" SelectedHeaderForeground="{DynamicResource Brush_Accent}">
                    <dc:PivotItem.HeaderTemplate>
                        <DataTemplate>
                            <Border ToolTip="{DynamicResource Language_Artist_Information}">
                                <TextBlock Margin="6,0,6,0"
                                           FontSize="16"
                                           Style="{StaticResource SegoeAssets}"
                                           Text="&#xE13D;" />
                            </Border>
                        </DataTemplate>
                    </dc:PivotItem.HeaderTemplate>
                </dc:PivotItem>
            </dc:Pivot>
            <!--  Playback controls  -->
            <commonviews:PlaybackControlsWithPlaylistNotification Grid.Column="1"
                                                                  HorizontalAlignment="Center"
                                                                  SnapsToDevicePixels="True"
                                                                  UseLayoutRounding="True" />
            <!--  Right pane  -->
            <DockPanel Grid.Column="2"
                       Margin="0,0,25,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <!--  Volume button  -->
                <commonviews:PopupVolumeControls Width="30"
                                                 Height="30"
                                                 Margin="10,0,0,0"
                                                 VerticalAlignment="Center"
                                                 DockPanel.Dock="Right"
                                                 ToolTip="{DynamicResource Language_Volume}" />
                <!--  Equalizer button  -->
                <ToggleButton x:Name="EqualizerButton"
                              Width="30"
                              Height="30"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Command="{Binding ShowEqualizerCommand}"
                              DockPanel.Dock="Right"
                              Style="{StaticResource TransparentToggleButton}"
                              ToolTip="{DynamicResource Language_Equalizer}">
                    <ToggleButton.Content>
                        <commonviews:EqualizerIcon />
                    </ToggleButton.Content>
                </ToggleButton>
                <!--  Time  -->
                <commonviews:TimeControl Margin="0,0,10,0" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
