<UserControl x:Class="Dopamine.Views.Common.EqualizerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:utils="clr-namespace:Dopamine.Utils"
             d:DesignHeight="300"
             d:DesignWidth="300"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetProperty="Opacity"
                                 To="1"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0.5"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
    </UserControl.Resources>

    <StackPanel Margin="20,20,20,0">
        <CheckBox Margin="0,0,0,15"
                  Content="{DynamicResource Language_Enable_Equalizer}"
                  DockPanel.Dock="Left"
                  IsChecked="{Binding IsEqualizerEnabled}"
                  Style="{StaticResource MetroCheckBox}" />
        <StackPanel IsHitTestVisible="{Binding IsEqualizerEnabled}">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEqualizerEnabled}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FadeOut}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <DockPanel>
                <DockPanel.Resources>
                    <utils:BindingProxy x:Key="DeleteProxy" Data="{DynamicResource Language_Delete}" />
                    <utils:BindingProxy x:Key="SaveProxy" Data="{DynamicResource Language_Save}" />
                </DockPanel.Resources>
                <Button Command="{Binding ResetCommand}"
                        Content="{DynamicResource Language_Reset}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource RegularButton}" />
                <Button Margin="0,0,10,0"
                        Command="{Binding SaveCommand}"
                        Content="{Binding Source={StaticResource SaveProxy}, Path=Data, Converter={StaticResource AddEllipsisConverter}}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource RegularButton}" />
                <Button Margin="0,0,10,0"
                        Command="{Binding DeleteCommand}"
                        Content="{Binding Source={StaticResource DeleteProxy}, Path=Data, Converter={StaticResource AddEllipsisConverter}}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource RegularButton}" />
                <ComboBox Margin="0,0,10,0"
                          ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset}"
                          Style="{StaticResource MetroComboBox}" />
            </DockPanel>
            <StackPanel Margin="0,15,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="{Binding IsEqualizerEnabled}"
                        Orientation="Horizontal">
                <Grid Height="215"
                      Margin="0,0,20,0"
                      VerticalAlignment="Top">
                    <TextBlock VerticalAlignment="Top"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="+20 dB" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="+0 dB" />
                    <TextBlock VerticalAlignment="Bottom"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="-20 dB" />
                </Grid>
                <StackPanel Width="30" Margin="0,0,0,0">
                    <dc:UWPSliderVertical Height="200"
                                          Margin="0,10,0,20"
                                          HorizontalAlignment="Center"
                                          BarBackground="{DynamicResource Brush_Accent}"
                                          ButtonBackground="{DynamicResource Brush_PrimaryText}"
                                          ButtonInnerBackground="{DynamicResource Brush_MainWindowBackground}"
                                          ChangeValueWhileDragging="True"
                                          Maximum="20"
                                          Minimum="-20"
                                          TrackBackground="{DynamicResource Brush_SliderBackground}"
                                          Value="{Binding Band0, Mode=TwoWay}" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="70" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_Accent}"
                               Text="{Binding Band0Label}" />
                </StackPanel>
                <StackPanel Width="30" Margin="15,0,0,0">
                    <dc:UWPSliderVertical Height="200"
                                          Margin="0,10,0,20"
                                          HorizontalAlignment="Center"
                                          BarBackground="{DynamicResource Brush_Accent}"
                                          ButtonBackground="{DynamicResource Brush_PrimaryText}"
                                          ButtonInnerBackground="{DynamicResource Brush_MainWindowBackground}"
                                          ChangeValueWhileDragging="True"
                                          Maximum="20"
                                          Minimum="-20"
                                          TrackBackground="{DynamicResource Brush_SliderBackground}"
                                          Value="{Binding Band1, Mode=TwoWay}" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="180" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_Accent}"
                               Text="{Binding Band1Label}" />
                </StackPanel>
                <StackPanel Width="30" Margin="15,0,0,0">
                    <dc:UWPSliderVertical Height="200"
                                          Margin="0,10,0,20"
                                          HorizontalAlignment="Center"
                                          BarBackground="{DynamicResource Brush_Accent}"
                                          ButtonBackground="{DynamicResource Brush_PrimaryText}"
                                          ButtonInnerBackground="{DynamicResource Brush_MainWindowBackground}"
                                          ChangeValueWhileDragging="True"
                                          Maximum="20"
                                          Minimum="-20"
                                          TrackBackground="{DynamicResource Brush_SliderBackground}"
                                          Value="{Binding Band2, Mode=TwoWay}" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="320" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_Accent}"
                               Text="{Binding Band2Label}" />
                </StackPanel>
                <StackPanel Width="30" Margin="15,0,0,0">
                    <dc:UWPSliderVertical Height="200"
                                          Margin="0,10,0,20"
                                          HorizontalAlignment="Center"
                                          BarBackground="{DynamicResource Brush_Accent}"
                                          ButtonBackground="{DynamicResource Brush_PrimaryText}"
                                          ButtonInnerBackground="{DynamicResource Brush_MainWindowBackground}"
                                          ChangeValueWhileDragging="True"
                                          Maximum="20"
                                          Minimum="-20"
                                          TrackBackground="{DynamicResource Brush_SliderBackground}"
                                          Value="{Binding Band3, Mode=TwoWay}" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="600" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_Accent}"
                               Text="{Binding Band3Label}" />
                </StackPanel>
                <StackPanel Width="30" Margin="15,0,0,0">
                    <dc:UWPSliderVertical Height="200"
                                          Margin="0,10,0,20"
                                          HorizontalAlignment="Center"
                                          BarBackground="{DynamicResource Brush_Accent}"
                                          ButtonBackground="{DynamicResource Brush_PrimaryText}"
                                          ButtonInnerBackground="{DynamicResource Brush_MainWindowBackground}"
                                          ChangeValueWhileDragging="True"
                                          Maximum="20"
                                          Minimum="-20"
                                          TrackBackground="{DynamicResource Brush_SliderBackground}"
                                          Value="{Binding Band4, Mode=TwoWay}" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="1K" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_Accent}"
                               Text="{Binding Band4Label}" />
                </StackPanel>
                <StackPanel Width="30" Margin="15,0,0,0">
                    <dc:UWPSliderVertical Height="200"
                                          Margin="0,10,0,20"
                                          HorizontalAlignment="Center"
                                          BarBackground="{DynamicResource Brush_Accent}"
                                          ButtonBackground="{DynamicResource Brush_PrimaryText}"
                                          ButtonInnerBackground="{DynamicResource Brush_MainWindowBackground}"
                                          ChangeValueWhileDragging="True"
                                          Maximum="20"
                                          Minimum="-20"
                                          TrackBackground="{DynamicResource Brush_SliderBackground}"
                                          Value="{Binding Band5, Mode=TwoWay}" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="3K" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_Accent}"
                               Text="{Binding Band5Label}" />
                </StackPanel>
                <StackPanel Width="30" Margin="15,0,0,0">
                    <dc:UWPSliderVertical Height="200"
                                          Margin="0,10,0,20"
                                          HorizontalAlignment="Center"
                                          BarBackground="{DynamicResource Brush_Accent}"
                                          ButtonBackground="{DynamicResource Brush_PrimaryText}"
                                          ButtonInnerBackground="{DynamicResource Brush_MainWindowBackground}"
                                          ChangeValueWhileDragging="True"
                                          Maximum="20"
                                          Minimum="-20"
                                          TrackBackground="{DynamicResource Brush_SliderBackground}"
                                          Value="{Binding Band6, Mode=TwoWay}" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="6K" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_Accent}"
                               Text="{Binding Band6Label}" />
                </StackPanel>
                <StackPanel Width="30" Margin="15,0,0,0">
                    <dc:UWPSliderVertical Height="200"
                                          Margin="0,10,0,20"
                                          HorizontalAlignment="Center"
                                          BarBackground="{DynamicResource Brush_Accent}"
                                          ButtonBackground="{DynamicResource Brush_PrimaryText}"
                                          ButtonInnerBackground="{DynamicResource Brush_MainWindowBackground}"
                                          ChangeValueWhileDragging="True"
                                          Maximum="20"
                                          Minimum="-20"
                                          TrackBackground="{DynamicResource Brush_SliderBackground}"
                                          Value="{Binding Band7, Mode=TwoWay}" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="12K" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_Accent}"
                               Text="{Binding Band7Label}" />
                </StackPanel>
                <StackPanel Width="30" Margin="15,0,0,0">
                    <dc:UWPSliderVertical Height="200"
                                          Margin="0,10,0,20"
                                          HorizontalAlignment="Center"
                                          BarBackground="{DynamicResource Brush_Accent}"
                                          ButtonBackground="{DynamicResource Brush_PrimaryText}"
                                          ButtonInnerBackground="{DynamicResource Brush_MainWindowBackground}"
                                          ChangeValueWhileDragging="True"
                                          Maximum="20"
                                          Minimum="-20"
                                          TrackBackground="{DynamicResource Brush_SliderBackground}"
                                          Value="{Binding Band8, Mode=TwoWay}" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="14K" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_Accent}"
                               Text="{Binding Band8Label}" />
                </StackPanel>
                <StackPanel Width="30" Margin="15,0,0,0">
                    <dc:UWPSliderVertical Height="200"
                                          Margin="0,10,0,20"
                                          HorizontalAlignment="Center"
                                          BarBackground="{DynamicResource Brush_Accent}"
                                          ButtonBackground="{DynamicResource Brush_PrimaryText}"
                                          ButtonInnerBackground="{DynamicResource Brush_MainWindowBackground}"
                                          ChangeValueWhileDragging="True"
                                          Maximum="20"
                                          Minimum="-20"
                                          TrackBackground="{DynamicResource Brush_SliderBackground}"
                                          Value="{Binding Band9, Mode=TwoWay}" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="16K" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_Accent}"
                               Text="{Binding Band9Label}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
