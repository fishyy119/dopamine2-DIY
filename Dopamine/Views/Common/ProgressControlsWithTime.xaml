<UserControl x:Class="Dopamine.Views.Common.ProgressControlsWithTime"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:base="clr-namespace:Dopamine.Core.Base;assembly=Dopamine.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             x:Name="ThisControl"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <StackPanel Orientation="Horizontal">
        <Label Width="50"
               Padding="0"
               HorizontalAlignment="Right"
               HorizontalContentAlignment="Right"
               Content="{Binding CurrentTime}"
               FontSize="{x:Static base:Constants.GlobalFontSize}"
               Foreground="{DynamicResource Brush_PrimaryText}" />
        <dc:UWPSliderHorizontal x:Name="ProgressSlider"
                                Width="{Binding SliderLength, ElementName=ThisControl}"
                                Margin="20,0,20,0"
                                BarBackground="{DynamicResource Brush_Accent}"
                                ButtonBackground="{DynamicResource Brush_PrimaryText}"
                                ButtonInnerBackground="{DynamicResource Brush_WindowHeaderBackground}"
                                IsHitTestVisible="{Binding CanReportProgress}"
                                Maximum="1"
                                TrackBackground="{DynamicResource Brush_SliderBackground}"
                                Value="{Binding ProgressValue, Mode=TwoWay}" />
        <Label Width="50"
               Padding="0"
               HorizontalAlignment="Left"
               HorizontalContentAlignment="Left"
               Content="{Binding TotalTime}"
               FontSize="{x:Static base:Constants.GlobalFontSize}"
               Foreground="{DynamicResource Brush_PrimaryText}" />
    </StackPanel>
</UserControl>
