<UserControl x:Class="Dopamine.Views.Common.EditTrack"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:enums="clr-namespace:Dopamine.Core.Enums;assembly=Dopamine.Core"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pc="clr-namespace:Dopamine.Controls"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             x:Name="ThisControl"
             d:DesignHeight="400"
             d:DesignWidth="600"
             prismMvvm:ViewModelLocator.AutoWireViewModel="False"
             mc:Ignorable="d">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.5"
                                 To="1"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1"
                                 To="0.5"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
    </UserControl.Resources>

    <DockPanel>
        <Border Height="50"
                Background="{DynamicResource Brush_WindowHeaderBackground}"
                DockPanel.Dock="Top">
            <DockPanel x:Name="MenuPanel">
                <Grid Width="30"
                      Height="30"
                      Margin="10">
                    <Viewbox Width="30"
                             Height="30"
                             Panel.ZIndex="0">
                        <Path x:Name="Droplet"
                              Data="{StaticResource Droplet}"
                              Fill="{DynamicResource Brush_Accent}" />
                    </Viewbox>
                    <TextBlock x:Name="Icon"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Panel.ZIndex="1"
                               FontSize="16"
                               Foreground="{DynamicResource Brush_WindowIcon}"
                               Style="{StaticResource SegoeAssets}"
                               Text="&#xE104;" />
                </Grid>
                <dc:Pivot DockPanel.Dock="Top"
                          SelectedIndex="{Binding SelectedEditTrackPage, Converter={StaticResource EnumConverter}, ConverterParameter={x:Type enums:EditTrackPage}}"
                          Style="{DynamicResource MenuPivot}">
                    <dc:PivotItem Header="{DynamicResource Language_Tags}" Style="{StaticResource MenuPivotItem}" />
                    <dc:PivotItem Header="{DynamicResource Language_Lyrics}" Style="{StaticResource MenuPivotItem}" />
                </dc:Pivot>
            </DockPanel>
        </Border>
        <!--  Multiple Tracks notification  -->
        <TextBlock Margin="20,20,20,0"
                   DockPanel.Dock="Top"
                   Foreground="{DynamicResource Brush_Accent}"
                   Text="{Binding MultipleTracksWarningText}"
                   TextWrapping="Wrap"
                   Visibility="{Binding ShowMultipleTracksWarning, Converter={StaticResource BooleanToCollapsedConverter}}" />
        <!--  Content  -->
        <Grid Margin="20,20,20,0">
            <Grid.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FadeOut}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Viewbox Width="40"
                     Height="40"
                     Panel.ZIndex="1"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToCollapsedConverter}}">
                <dc:ProgressRing Foreground="{DynamicResource Brush_Accent}" IsActive="{Binding IsBusy}" />
            </Viewbox>
            <pc:TransitioningContentControl Content="{Binding EditTrackContent}"
                                            FadeIn="True"
                                            FadeInTimeout="0.5"
                                            SlideIn="True"
                                            SlideInFrom="{Binding SlideInFrom}"
                                            SlideInTimeout="0.5"
                                            SlideInTo="0" />
        </Grid>
    </DockPanel>
</UserControl>
