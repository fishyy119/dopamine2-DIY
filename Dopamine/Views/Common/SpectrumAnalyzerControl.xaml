<UserControl x:Class="Dopamine.Views.Common.SpectrumAnalyzerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dopamine.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="0:0:0.25" />
            </Storyboard>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1"
                                 To="0"
                                 Duration="0:0:0.25" />
            </Storyboard>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="SpectrumContainer"
          ClipToBounds="True"
          Visibility="Visible">
        <StackPanel Width="{Binding SpectrumPanelWidth}"
                    Height="{Binding SpectrumPanelHeight}"
                    Margin="0,0,0,-1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Panel.ZIndex="1"
                    Opacity="{Binding SpectrumOpacity}"
                    Orientation="Horizontal">
            <StackPanel.Effect>
                <BlurEffect Radius="{Binding BlurRadius}" />
            </StackPanel.Effect>
            <controls:SpectrumAnalyzer x:Name="LeftSpectrumAnalyzer"
                                       Width="{Binding SpectrumWidth}"
                                       Margin="2,0,0,0"
                                       AnimationStyle="{Binding AnimationStyle}"
                                       BarBackground="{DynamicResource Brush_Accent}"
                                       BarCount="{Binding SpectrumBarCount}"
                                       BarSpacing="{Binding SpectrumBarSpacing}"
                                       BarWidth="{Binding SpectrumBarWidth}"
                                       RefreshInterval="{Binding RefreshInterval}"
                                       RenderTransformOrigin="0.5,0.5"
                                       Style="{StaticResource SpectrumAnalyzer}">
                <controls:SpectrumAnalyzer.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </controls:SpectrumAnalyzer.RenderTransform>
            </controls:SpectrumAnalyzer>
            <controls:SpectrumAnalyzer x:Name="RightSpectrumAnalyzer"
                                       Width="{Binding SpectrumWidth}"
                                       Margin="-4,0,0,0"
                                       AnimationStyle="{Binding AnimationStyle}"
                                       BarBackground="{DynamicResource Brush_Accent}"
                                       BarCount="{Binding SpectrumBarCount}"
                                       BarSpacing="{Binding SpectrumBarSpacing}"
                                       BarWidth="{Binding SpectrumBarWidth}"
                                       RefreshInterval="{Binding RefreshInterval}"
                                       Style="{StaticResource SpectrumAnalyzer}" />
        </StackPanel>
        <Ellipse Width="{Binding SpectrumEllipseWidth}"
                 Height="50"
                 Margin="0,0,0,-25"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Panel.ZIndex="0"
                 Fill="{DynamicResource Brush_SpectrumEllipse}"
                 Opacity="1">
            <Ellipse.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FadeOut}" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>
    </Grid>
</UserControl>
