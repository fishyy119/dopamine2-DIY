<UserControl x:Class="Dopamine.Views.Common.PlaybackControlsWithPlaylistNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             xmlns:pv="clr-namespace:Dopamine.Views"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="MouseEnter">
            <i:InvokeCommandAction Command="{Binding PlaylistNotificationMouseEnterCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="1"
                Opacity="1">
            <pv:PlaybackControls HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowAddedTracksToPlaylistText}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1"
                                                         To="0"
                                                         Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation BeginTime="0:0:0.20"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Border Margin="0,0,0,-30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="0"
                Opacity="0">
            <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="Icon"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           FontSize="14"
                           Foreground="{DynamicResource Brush_Accent}"
                           Style="{StaticResource SegoeAssets}"
                           Text="&#xE8FB;" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{Binding AddedTracksToPlaylistText}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Border.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowAddedTracksToPlaylistText}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation BeginTime="0:0:0.10"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.25" />
                                        <ThicknessAnimation BeginTime="0:0:0.10"
                                                            Storyboard.TargetProperty="Margin"
                                                            From="0,0,0,-30"
                                                            To="0,0,0,0"
                                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1"
                                                         To="0"
                                                         Duration="0:0:0.15" />
                                        <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                            From="0,0,0,0"
                                                            To="0,-30,0,0"
                                                            Duration="0:0:0.25" />
                                        <ThicknessAnimation BeginTime="0:0:0.25"
                                                            Storyboard.TargetProperty="Margin"
                                                            From="0,-30,0,0"
                                                            To="0,0,0,-30"
                                                            Duration="0:0:0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
