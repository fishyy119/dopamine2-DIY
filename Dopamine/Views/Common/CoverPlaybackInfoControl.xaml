<UserControl x:Class="Dopamine.Views.Common.CoverPlaybackInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pc="clr-namespace:Dopamine.Controls"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             xmlns:pv="clr-namespace:Dopamine.ViewModels"
             x:Name="ThisControl"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type pv:PlaybackInfoViewModel}">
            <StackPanel>
                <pc:ScalingTextBlock FontWeight="Light"
                                     Foreground="{DynamicResource Brush_ImageOverlayText}"
                                     MaxFontSize="{Binding TitleFontSize, ElementName=ThisControl}"
                                     MinFontSize="{Binding ArtistFontSize, ElementName=ThisControl}"
                                     Text="{Binding Title}"
                                     TextAlignment="{Binding TextAlignment, ElementName=ThisControl}"
                                     TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,-2,0,0"
                           FontSize="{Binding ArtistFontSize, ElementName=ThisControl}"
                           FontWeight="Light"
                           Foreground="{DynamicResource Brush_ImageOverlayText}"
                           Text="{Binding Artist}"
                           TextAlignment="{Binding TextAlignment, ElementName=ThisControl}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <dc:SlidingContentControl Width="{Binding ActualWidth, ElementName=ThisControl}"
                              Height="{Binding ActualHeight, ElementName=ThisControl}"
                              Content="{Binding PlaybackInfoViewModel}"
                              EasingAmplitude="0"
                              SlideDirection="{Binding SlideDirection}"
                              SlideFadeIn="True" />
</UserControl>
