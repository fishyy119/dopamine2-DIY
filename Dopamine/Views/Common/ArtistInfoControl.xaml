<UserControl x:Class="Dopamine.Views.Common.ArtistInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             xmlns:pv="clr-namespace:Dopamine.ViewModels"
             x:Name="ThisControl"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.5"
                                 To="1"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1"
                                 To="0.5"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
        <DataTemplate DataType="{x:Type pv:ArtistInfoViewModel}">
            <DockPanel>
                <StackPanel>
                    <Grid DockPanel.Dock="Left">
                        <Image MaxWidth="300"
                               MaxHeight="300"
                               Margin="20"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding Image}"
                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToCollapsedConverter}}">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  Opacity="{DynamicResource Opacity_CoverArtShadow}"
                                                  ShadowDepth="0"
                                                  Color="{DynamicResource Color_Black}" />
                            </Image.Effect>
                        </Image>
                        <Border Width="200"
                                Height="200"
                                Margin="20"
                                Background="{DynamicResource Brush_CoverTileBackground}"
                                Visibility="{Binding HasImage, Converter={StaticResource InvertingBooleanToCollapsedConverter}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  Opacity="{DynamicResource Opacity_CoverArtShadow}"
                                                  ShadowDepth="0"
                                                  Color="{DynamicResource Color_Black}" />
                            </Border.Effect>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="100"
                                       Foreground="{DynamicResource Brush_CoverTileIcon}"
                                       Style="{StaticResource SegoeAssets}"
                                       Text="&#xE13D;" />
                        </Border>
                    </Grid>
                    <TextBlock Margin="20,0,0,0"
                               FontSize="22"
                               FontWeight="Light"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="{Binding ArtistName}" />
                </StackPanel>
                <ScrollViewer Padding="20,15,10,0"
                              PanningMode="Both"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,0,0,0">
                        <Label Margin="0,0,0,20"
                               Content="{DynamicResource Language_Biography}"
                               Style="{StaticResource TitleLabel}" />
                        <Grid>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource Brush_PrimaryText}"
                                           Text="{Binding Path=CleanedBiographyContent}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasBiography, Converter={StaticResource BooleanToCollapsedConverter}}" />
                                <Button Margin="0,10,0,0"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{Binding Path=Url}"
                                        Content="{Binding UrlText}"
                                        Foreground="{DynamicResource Brush_PrimaryText}"
                                        Style="{StaticResource LinkButton}" />
                            </StackPanel>
                            <TextBlock Foreground="{DynamicResource Brush_PrimaryText}"
                                       Text="{DynamicResource Language_Not_Available}"
                                       Visibility="{Binding HasBiography, Converter={StaticResource InvertingBooleanToCollapsedConverter}}" />
                        </Grid>
                        <Label Margin="0,20,0,20"
                               Content="{DynamicResource Language_Similar}"
                               Style="{StaticResource TitleLabel}" />
                        <Grid>
                            <ListBox ItemsSource="{Binding SimilarArtists}"
                                     Style="{StaticResource ListBoxSimilarArtists}"
                                     Visibility="{Binding HasSimilarArtists, Converter={StaticResource BooleanToCollapsedConverter}}" />
                            <TextBlock Foreground="{DynamicResource Brush_PrimaryText}"
                                       Text="{DynamicResource Language_Not_Available}"
                                       Visibility="{Binding HasSimilarArtists, Converter={StaticResource InvertingBooleanToCollapsedConverter}}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <dc:SlidingContentControl Width="{Binding ActualWidth, ElementName=ThisControl}"
                                  Height="{Binding ActualHeight, ElementName=ThisControl}"
                                  Panel.ZIndex="0"
                                  Content="{Binding ArtistInfoViewModel}"
                                  EasingAmplitude="0"
                                  SlideDirection="{Binding SlideDirection}">
            <dc:SlidingContentControl.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FadeOut}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </dc:SlidingContentControl.Style>
        </dc:SlidingContentControl>
        <dc:ProgressRing Width="60"
                         Height="60"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Panel.ZIndex="1"
                         Foreground="{DynamicResource Brush_Accent}"
                         IsActive="{Binding IsBusy}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToCollapsedConverter}}" />
    </Grid>
</UserControl>
