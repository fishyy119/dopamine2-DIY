<UserControl x:Class="Dopamine.Views.Common.PlayAllControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pc="clr-namespace:Dopamine.Controls"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <pc:IconTextButton Margin="5"
                       HorizontalAlignment="Left"
                       Command="{Binding PlayAllCommand}"
                       Content="{DynamicResource Language_Play_All}"
                       Foreground="{DynamicResource Brush_Accent}"
                       Glyph="&#xE768;"
                       GlyphSize="13" />
</UserControl>
