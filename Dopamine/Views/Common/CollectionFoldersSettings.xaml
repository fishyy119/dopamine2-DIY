<UserControl x:Class="Dopamine.Views.Common.CollectionFoldersSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pc="clr-namespace:Dopamine.Controls"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             x:Name="Me"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.5"
                                 To="1"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <Storyboard>
                <DoubleAnimation BeginTime="0:0:0"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1"
                                 To="0.5"
                                 Duration="0:0:0.15" />
            </Storyboard>
        </Storyboard>
    </UserControl.Resources>
    <DockPanel>
        <pc:IconTextButton Margin="0,0,0,20"
                           HorizontalAlignment="Left"
                           Command="{Binding Path=AddFolderCommand}"
                           Content="{DynamicResource Language_Add_A_Folder}"
                           DockPanel.Dock="Top"
                           Foreground="{DynamicResource Brush_Accent}"
                           Glyph="&#xE710;"
                           GlyphSize="13"
                           IsHitTestVisible="{Binding IsBusy, Converter={StaticResource InvertingBooleanConverter}}" />
        <Grid>
            <DockPanel Panel.ZIndex="0" IsHitTestVisible="{Binding IsBusy, Converter={StaticResource InvertingBooleanConverter}}">
                <DockPanel.Style>
                    <Style>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeOut}" />
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <CheckBox Margin="11,0,0,20"
                          Padding="12,0,0,0"
                          Content="{DynamicResource Language_Show_All_Folders_In_Collection}"
                          DockPanel.Dock="Top"
                          IsChecked="{Binding ShowAllFoldersInCollection}"
                          Style="{StaticResource MetroCheckBox}"
                          Visibility="{Binding ShowControls, Converter={StaticResource BooleanToCollapsedConverter}, ElementName=Me}" />
                <ListBox x:Name="ListBoxFolders"
                         ItemsSource="{Binding Folders}"
                         Style="{StaticResource ListBoxFolders}" />
            </DockPanel>
            <Viewbox Width="48"
                     Height="48"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Panel.ZIndex="1"
                     Visibility="{Binding IsLoadingFolders, Converter={StaticResource BooleanToCollapsedConverter}}">
                <dc:ProgressRing HorizontalAlignment="Center"
                                 Foreground="{DynamicResource Brush_Accent}"
                                 IsActive="{Binding IsLoadingFolders}" />
            </Viewbox>
            <DockPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Panel.ZIndex="1"
                       Visibility="{Binding IsIndexing, Converter={StaticResource BooleanToCollapsedConverter}}">
                <pc:SyncRing Width="24"
                             DockPanel.Dock="Left"
                             Foreground="{DynamicResource Brush_PrimaryText}" />
                <TextBlock Margin="15,0,0,0"
                           FontSize="18"
                           FontWeight="Light"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Refreshing_Collection}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>

