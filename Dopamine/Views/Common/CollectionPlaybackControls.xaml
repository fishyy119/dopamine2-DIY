<UserControl x:Class="Dopamine.Views.Common.CollectionPlaybackControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:commonviews="clr-namespace:Dopamine.Views.Common"
             xmlns:cp="clr-namespace:Dopamine.Core.Prism;assembly=Dopamine.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             xmlns:utils="clr-namespace:Dopamine.Utils"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Setting this CollectionViewSource as a ContextMenu resource doesn't work. Binding with ContextMenuPlaylists fails. No idea why.  -->
        <CollectionViewSource x:Key="PlaylistsDataSource" Source="{Binding ContextMenuPlaylists}" />
    </UserControl.Resources>

    <DockPanel Height="80">
        <!--  Progress slider  -->
        <commonviews:ProgressControls Panel.ZIndex="99" DockPanel.Dock="Top" />
        <Grid Margin="0,-6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  Playback info  -->
            <DockPanel x:Name="PlaybackInfoPanel"
                       Grid.Column="0"
                       Height="70"
                       Background="#00000000"
                       Cursor="Hand"
                       ToolTip="{DynamicResource Language_Now_Playing}">
                <DockPanel.ContextMenu>
                    <ContextMenu>
                        <ContextMenu.Resources>
                            <utils:BindingProxy x:Key="NewPlaylistProxy" Data="{DynamicResource Language_New_Playlist}" />
                        </ContextMenu.Resources>
                        <MenuItem DisplayMemberPath="Name" Header="{DynamicResource Language_Add_To_Playlist}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Command" Value="{Binding DataContext.AddPlayingTrackToPlaylistCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                                    <Setter Property="CommandParameter" Value="{Binding Name}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                            <MenuItem.ItemsSource>
                                <CompositeCollection>
                                    <MenuItem Header="{Binding Source={StaticResource NewPlaylistProxy}, Path=Data, Converter={StaticResource AddEllipsisConverter}}" />
                                    <Separator />
                                    <CollectionContainer Collection="{Binding Source={StaticResource PlaylistsDataSource}}" />
                                </CompositeCollection>
                            </MenuItem.ItemsSource>
                            <MenuItem.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </MenuItem.ItemsPanel>
                            <MenuItem.Template>
                                <ControlTemplate TargetType="MenuItem">
                                    <Grid>
                                        <MenuItem DisplayMemberPath="Name" Header="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                                            <MenuItem.ItemsSource>
                                                <CompositeCollection>
                                                    <Separator />
                                                </CompositeCollection>
                                            </MenuItem.ItemsSource>
                                        </MenuItem>
                                        <Popup AllowsTransparency="True"
                                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                                               Placement="Right"
                                               PopupAnimation="Fade">
                                            <Border Background="White"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="8,10,5,10">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="8"
                                                                      Opacity="0.6"
                                                                      ShadowDepth="0" />
                                                </Border.Effect>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </MenuItem.Template>
                        </MenuItem>
                    </ContextMenu>
                </DockPanel.ContextMenu>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{x:Static cp:ApplicationCommands.ShowNowPlayingCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <commonviews:CoverArtControl x:Name="CoverArtControl"
                                             Width="70"
                                             Height="70"
                                             DockPanel.Dock="Left" />
                <!--  Keep clicks available for navigation to Now Playing.  -->
                <commonviews:PlaybackInfoControl Height="70"
                                                 Margin="10,0,0,0"
                                                 VerticalAlignment="Center"
                                                 EnableQuickCopy="False"
                                                 ShowLoveAndRating="True"
                                                 TitleFontWeight="Light" />
            </DockPanel>
            <!--  Playback controls  -->
            <commonviews:PlaybackControlsWithPlaylistNotification Grid.Column="1"
                                                                  HorizontalAlignment="Center"
                                                                  SnapsToDevicePixels="True"
                                                                  UseLayoutRounding="True" />
            <!--  Right pane  -->
            <DockPanel Grid.Column="2"
                       Margin="0,0,25,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <!--  Volume button  -->
                <commonviews:PopupVolumeControls Width="30"
                                                 Height="30"
                                                 Margin="10,0,0,0"
                                                 VerticalAlignment="Center"
                                                 DockPanel.Dock="Right"
                                                 ToolTip="{DynamicResource Language_Volume}" />
                <!--  Equalizer button  -->
                <ToggleButton x:Name="EqualizerButton"
                              Width="30"
                              Height="30"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Command="{Binding ShowEqualizerCommand}"
                              DockPanel.Dock="Right"
                              Style="{StaticResource TransparentToggleButton}"
                              ToolTip="{DynamicResource Language_Equalizer}">
                    <ToggleButton.Content>
                        <commonviews:EqualizerIcon />
                    </ToggleButton.Content>
                </ToggleButton>
                <!--  Now Playing button  -->
                <Button x:Name="NowPlayingButton"
                        Width="30"
                        Height="30"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{x:Static cp:ApplicationCommands.ShowNowPlayingCommand}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource TransparentButton}"
                        ToolTip="{DynamicResource Language_Now_Playing}">
                    <TextBlock FontSize="16"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Style="{StaticResource SegoeAssets}"
                               Text="&#xE90B;" />
                </Button>
                <!--  Time  -->
                <commonviews:TimeControl Margin="0,0,10,0" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>

