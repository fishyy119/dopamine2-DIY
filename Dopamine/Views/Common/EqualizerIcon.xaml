<UserControl x:Class="Dopamine.Views.Common.EqualizerIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="EqualizerIconElement"
             Width="30"
             Height="30"
             d:DesignHeight="30"
             d:DesignWidth="30"
             mc:Ignorable="d">

    <Border x:Name="BorderElement" BorderThickness="0">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=EqualizerIconElement, Path=IsDialogIcon}" Value="False">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush_PrimaryText}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ElementName=EqualizerIconElement, Path=IsDialogIcon}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush_WindowIcon}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Canvas Width="30" Height="30">
            <!--  Vertical lines  -->
            <Line Stroke="{Binding Path=BorderBrush, ElementName=BorderElement}"
                  StrokeThickness="1"
                  X1="8.5"
                  X2="8.5"
                  Y1="8"
                  Y2="22" />
            <Line Stroke="{Binding Path=BorderBrush, ElementName=BorderElement}"
                  StrokeThickness="1"
                  X1="15.5"
                  X2="15.5"
                  Y1="8"
                  Y2="22" />
            <Line Stroke="{Binding Path=BorderBrush, ElementName=BorderElement}"
                  StrokeThickness="1"
                  X1="22.5"
                  X2="22.5"
                  Y1="8"
                  Y2="22" />
            <!--  Circles  -->
            <Ellipse Canvas.Left="6.5"
                     Canvas.Top="11"
                     Width="4"
                     Height="4"
                     Fill="{Binding Path=BorderBrush, ElementName=BorderElement}" />
            <Ellipse Canvas.Left="13.5"
                     Canvas.Top="15"
                     Width="4"
                     Height="4"
                     Fill="{Binding Path=BorderBrush, ElementName=BorderElement}" />
            <Ellipse Canvas.Left="20.5"
                     Canvas.Top="12"
                     Width="4"
                     Height="4"
                     Fill="{Binding Path=BorderBrush, ElementName=BorderElement}" />
        </Canvas>
    </Border>
</UserControl>
