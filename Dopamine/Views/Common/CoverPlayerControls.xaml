<UserControl x:Class="Dopamine.Views.Common.CoverPlayerControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:commonviews="clr-namespace:Dopamine.Views.Common"
             xmlns:cp="clr-namespace:Dopamine.Core.Prism;assembly=Dopamine.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             xmlns:pv="clr-namespace:Dopamine.Views"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="False"
             mc:Ignorable="d">

    <!--  Playback controls  -->
    <StackPanel Height="70"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Panel.ZIndex="1"
                Orientation="Horizontal">
        <ToggleButton x:Name="PlaylistButton"
                      Width="30"
                      Height="30"
                      Margin="0,0,13,0"
                      VerticalAlignment="Center"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Command="{x:Static cp:ApplicationCommands.CoverPlayerPlaylistButtonCommand}"
                      CommandParameter="{Binding Path=IsChecked, RelativeSource={RelativeSource Self}}"
                      Style="{StaticResource TransparentToggleButton}"
                      ToolTip="{DynamicResource Language_Playlist}">
            <Grid>
                <TextBlock FontSize="20"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Style="{StaticResource SegoeAssets}"
                           Text="&#xEA37;"
                           Visibility="{Binding IsChecked, ElementName=PlaylistButton, Converter={StaticResource InvertingBooleanToVisibilityConverter}}" />
                <TextBlock FontSize="20"
                           Foreground="{DynamicResource Brush_Accent}"
                           Style="{StaticResource SegoeAssets}"
                           Text="&#xEA37;"
                           Visibility="{Binding IsChecked, ElementName=PlaylistButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </ToggleButton>
        <pv:PlaybackControls Margin="0,0,13,0" />
        <commonviews:PopupVolumeControls Width="30"
                                         Height="30"
                                         VerticalAlignment="Center"
                                         ToolTip="{DynamicResource Language_Volume}" />
    </StackPanel>
</UserControl>
