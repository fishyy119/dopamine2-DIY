<UserControl x:Class="Dopamine.Views.Common.ProgressControlsThin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <dc:UWPSliderHorizontalBottom x:Name="ProgressSliderThin"
                                  BarBackground="{DynamicResource Brush_Accent}"
                                  ButtonBackground="{DynamicResource Brush_PrimaryText}"
                                  ButtonInnerBackground="{DynamicResource Brush_WindowHeaderBackground}"
                                  IsHitTestVisible="{Binding CanReportProgress}"
                                  Maximum="1"
                                  TrackBackground="{DynamicResource Brush_SliderBackground}"
                                  Value="{Binding ProgressValue, Mode=TwoWay}" />
</UserControl>
