<UserControl x:Class="Dopamine.Views.Common.TimeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="ThisControl"
             d:DesignHeight="300"
             d:DesignWidth="300"
             mc:Ignorable="d">

    <StackPanel VerticalAlignment="Center"
                DataContext="{Binding PlaybackInfoViewModel}"
                Orientation="Horizontal">
        <Label x:Name="CurrentTime"
               Padding="0"
               Content="{Binding CurrentTime}"
               Foreground="{DynamicResource Brush_PrimaryText}" />
        <Label x:Name="TotalTime"
               Padding="0"
               Content="{Binding TotalTime}"
               Foreground="{DynamicResource Brush_SecondaryText}" />
    </StackPanel>
</UserControl>
