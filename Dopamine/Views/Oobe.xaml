<dc:Windows10BorderlessWindow x:Class="Dopamine.Views.Oobe"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:base="clr-namespace:Dopamine.Core.Base;assembly=Dopamine.Core"
                              xmlns:commonviews="clr-namespace:Dopamine.Views.Common"
                              xmlns:controls="clr-namespace:Dopamine.Controls"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
                              xmlns:enums="clr-namespace:Dopamine.Core.Enums;assembly=Dopamine.Core"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
                              Title="Dopamine"
                              Width="400"
                              Height="550"
                              prismMvvm:ViewModelLocator.AutoWireViewModel="True"
                              ApplyDefaultButtonColors="False"
                              Background="Transparent"
                              CloseBackground="Transparent"
                              CloseForeground="{DynamicResource Brush_SecondaryText}"
                              CloseHoveredBackground="{DynamicResource Brush_Accent}"
                              CloseHoveredForeground="{DynamicResource Brush_WindowButtonHoveredIcon}"
                              ClosePressedBackground="{DynamicResource Brush_WindowButtonPressedBackground}"
                              ClosePressedForeground="{DynamicResource Brush_WindowButtonPressedIcon}"
                              CloseToolTip="{DynamicResource Language_Close}"
                              Closing="Window_Closing"
                              IsOverlayVisible="{Binding Path=IsOverlayVisible}"
                              OverlayBackground="{DynamicResource Brush_DimBackground}"
                              ResizeMode="NoResize"
                              WindowStartupLocation="CenterScreen"
                              mc:Ignorable="d">

    <!--  Triggers  -->
    <dc:Windows10BorderlessWindow.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!--  PART_Border  -->
                    <DoubleAnimation BeginTime="0:0:0"
                                     Storyboard.TargetName="WindowBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </dc:Windows10BorderlessWindow.Triggers>

    <!--  Background  -->
    <Border x:Name="WindowBorder"
            Background="{DynamicResource Brush_MainWindowBackground}"
            BorderThickness="0"
            Opacity="0">
        <!--  Content  -->
        <DockPanel>
            <controls:FullLogo Margin="30,30,30,0"
                               Accent="{DynamicResource Brush_Accent}"
                               DockPanel.Dock="Top"
                               Foreground="{DynamicResource Brush_PrimaryText}" />
            <!--  Controls  -->
            <DockPanel Margin="0,0,30,30"
                       HorizontalAlignment="Right"
                       DockPanel.Dock="Bottom">
                <Grid>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding CanFinish, Converter={StaticResource InvertingBooleanToCollapsedConverter}}">
                        <Button x:Name="ButtonGoBack"
                                Margin="0,0,15,0"
                                Command="{Binding GoBackCommand}"
                                Foreground="{DynamicResource Brush_Accent}"
                                Style="{StaticResource TransparentButton}"
                                ToolTip="{DynamicResource Language_Previous}"
                                Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="24"
                                       Foreground="{DynamicResource Brush_Accent}"
                                       Style="{StaticResource SegoeAssets}"
                                       Text="&#xE00E;" />
                        </Button>
                        <Button x:Name="ButtonGoForward"
                                Command="{Binding GoForwardCommand}"
                                Foreground="{DynamicResource Brush_Accent}"
                                Style="{StaticResource TransparentButton}"
                                ToolTip="{DynamicResource Language_Next}">
                            <TextBlock FontSize="24"
                                       Foreground="{DynamicResource Brush_Accent}"
                                       Style="{StaticResource SegoeAssets}"
                                       Text="&#xE00F;" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="ButtonFinish"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="ButtonFinish_Click"
                            Foreground="{DynamicResource Brush_Accent}"
                            Style="{StaticResource TransparentButton}"
                            ToolTip="{DynamicResource Language_Start}"
                            Visibility="{Binding CanFinish, Converter={StaticResource BooleanToCollapsedConverter}}">
                        <TextBlock FontSize="24"
                                   Foreground="{DynamicResource Brush_Accent}"
                                   Style="{StaticResource SegoeAssets}"
                                   Text="&#xE8FB;" />
                    </Button>
                </Grid>
            </DockPanel>
            <!--  Wizard  -->
            <DockPanel Margin="0,30,0,30">
                <Border x:Name="proxyborder"
                        Background="{DynamicResource Brush_Accent}"
                        DockPanel.Dock="Top"
                        Visibility="Collapsed" />
                <dc:PageIndicator Margin="10"
                                  ActiveItem="{Binding SelectedIndex, ElementName=oobewizard}"
                                  DockPanel.Dock="Bottom"
                                  ItemFill="{Binding Path=Background, ElementName=proxyborder, Converter={StaticResource BrushOpacityConverter}, ConverterParameter=0.3}"
                                  ItemSize="8"
                                  ItemSpacing="10"
                                  NumberOfItems="6"
                                  SelectedItemFill="{DynamicResource Brush_Accent}" />
                <dc:Pivot x:Name="oobewizard"
                          AnimationType="SlideHorizontal"
                          DisableTabKey="True"
                          FeatheringRadius="24"
                          HeaderVisibility="Collapsed"
                          SelectedIndex="{Binding SelectedOobePage, Mode=TwoWay, Converter={StaticResource EnumConverter}, ConverterParameter={x:Type enums:OobePage}}">
                    <!--  Welcome  -->
                    <dc:PivotItem>
                        <StackPanel Margin="30,0,30,0">
                            <TextBlock FontSize="{Binding Source={x:Static base:Constants.OobeTitleFontSize}}"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource Brush_Accent}"
                                       Text="Hi!"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="{Binding Source={x:Static base:Constants.OobeTextFontSize}}"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource Brush_PrimaryText}"
                                       Text="Welcome to Dopamine, you'll love it! First, let's set things up."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </dc:PivotItem>
                    <!--  Language  -->
                    <dc:PivotItem>
                        <StackPanel Margin="30,0,30,0">
                            <Label Padding="0"
                                   Content="{DynamicResource Language_Language}"
                                   FontSize="{Binding Source={x:Static base:Constants.OobeTitleFontSize}}"
                                   FontWeight="Light"
                                   Foreground="{DynamicResource Brush_Accent}" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="{Binding Source={x:Static base:Constants.OobeTextFontSize}}"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource Brush_PrimaryText}"
                                       Text="{DynamicResource Language_Pick_Your_Language}"
                                       TextWrapping="Wrap" />
                            <commonviews:AppearanceLanguage Margin="0,15,0,0" />
                        </StackPanel>
                    </dc:PivotItem>
                    <!--  Appearance  -->
                    <dc:PivotItem>
                        <StackPanel Margin="30,0,30,0">
                            <Label Padding="0"
                                   Content="{DynamicResource Language_Appearance}"
                                   FontSize="{Binding Source={x:Static base:Constants.OobeTitleFontSize}}"
                                   FontWeight="Light"
                                   Foreground="{DynamicResource Brush_Accent}" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="{Binding Source={x:Static base:Constants.OobeTextFontSize}}"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource Brush_PrimaryText}"
                                       Text="{DynamicResource Language_What_Will_Your_Dopamine_Look_Like}"
                                       TextWrapping="Wrap" />
                            <commonviews:AppearanceTheme Margin="0,15,0,0" ShowFollowAlbumCoverColor="False" />
                        </StackPanel>
                    </dc:PivotItem>
                    <!--  Music  -->
                    <dc:PivotItem>
                        <DockPanel Margin="30,0,30,0">
                            <Label Padding="0"
                                   Content="{DynamicResource Language_Music}"
                                   DockPanel.Dock="Top"
                                   FontSize="{Binding Source={x:Static base:Constants.OobeTitleFontSize}}"
                                   FontWeight="Light"
                                   Foreground="{DynamicResource Brush_Accent}" />
                            <TextBlock Margin="0,5,0,0"
                                       DockPanel.Dock="Top"
                                       FontSize="{Binding Source={x:Static base:Constants.OobeTextFontSize}}"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource Brush_PrimaryText}"
                                       Text="{DynamicResource Language_Lets_Set_Up_Your_Collection}"
                                       TextWrapping="Wrap" />
                            <commonviews:CollectionFoldersSettings Margin="0,15,0,15" ShowControls="False" />
                        </DockPanel>
                    </dc:PivotItem>
                    <!--  Donate  -->
                    <dc:PivotItem>
                        <StackPanel Margin="30,0,30,0">
                            <Label Padding="0"
                                   Content="{DynamicResource Language_Donate}"
                                   FontSize="{Binding Source={x:Static base:Constants.OobeTitleFontSize}}"
                                   FontWeight="Light"
                                   Foreground="{DynamicResource Brush_Accent}" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="{Binding Source={x:Static base:Constants.OobeTextFontSize}}"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource Brush_PrimaryText}"
                                       Text="{DynamicResource Language_If_You_Like_Dopamine_Please_Donate}"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding OpenLinkCommand}"
                                    CommandParameter="{x:Static base:ContactInformation.DonateLink}"
                                    Content="{DynamicResource Language_Donate}"
                                    Style="{StaticResource LinkButton}"
                                    ToolTip="{DynamicResource Language_Donate_With_PayPal}" />
                        </StackPanel>
                    </dc:PivotItem>
                    <!--  Finish  -->
                    <dc:PivotItem>
                        <StackPanel Margin="30,0,30,0">
                            <Label Padding="0"
                                   Content="{DynamicResource Language_Done}"
                                   FontSize="{Binding Source={x:Static base:Constants.OobeTitleFontSize}}"
                                   FontWeight="Light"
                                   Foreground="{DynamicResource Brush_Accent}" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="{Binding Source={x:Static base:Constants.OobeTextFontSize}}"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource Brush_PrimaryText}"
                                       Text="{DynamicResource Language_We_Are_Done}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </dc:PivotItem>
                </dc:Pivot>
            </DockPanel>
        </DockPanel>
    </Border>
</dc:Windows10BorderlessWindow>
