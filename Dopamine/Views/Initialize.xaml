<dc:Windows10BorderlessWindow x:Class="Dopamine.Views.Initialize"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
                              Title="Dopamine"
                              Width="350"
                              Height="75"
                              prismMvvm:ViewModelLocator.AutoWireViewModel="True"
                              Background="#0B0B0B"
                              Loaded="Window_Loaded"
                              ShowWindowControls="False"
                              WindowStartupLocation="CenterScreen"
                              mc:Ignorable="d">

    <DockPanel HorizontalAlignment="Center">
        <dc:ProgressRing Width="30"
                         Height="30"
                         VerticalAlignment="Center"
                         Panel.ZIndex="1"
                         Foreground="#1D7DD4"
                         IsActive="True" />
        <TextBlock Margin="30,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="22"
                   FontWeight="Light"
                   Foreground="White"
                   Text="{Binding InitializeText}" />
    </DockPanel>
</dc:Windows10BorderlessWindow>
