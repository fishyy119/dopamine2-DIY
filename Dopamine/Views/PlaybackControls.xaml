<UserControl x:Class="Dopamine.Views.PlaybackControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
        <!--  Loop  -->
        <Button x:Name="LoopButton"
                Width="30"
                Height="30"
                Margin="0,0,13,0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding LoopCommand}"
                Style="{StaticResource TransparentButton}"
                ToolTip="{DynamicResource Language_Loop}">
            <Grid>
                <TextBlock FontSize="14"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Style="{StaticResource SegoeAssets}"
                           Text="&#xE8EE;"
                           Visibility="{Binding ShowLoopNone, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock FontSize="14"
                           Foreground="{DynamicResource Brush_Accent}"
                           Style="{StaticResource SegoeAssets}"
                           Text="&#xE8ED;"
                           Visibility="{Binding ShowLoopOne, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock FontSize="14"
                           Foreground="{DynamicResource Brush_Accent}"
                           Style="{StaticResource SegoeAssets}"
                           Text="&#xE8EE;"
                           Visibility="{Binding ShowLoopAll, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Button>
        <!--  Previous  -->
        <Button x:Name="PreviousButton"
                Width="30"
                Height="30"
                Margin="0,0,13,0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding PreviousCommand}"
                Style="{StaticResource TransparentButton}"
                ToolTip="{DynamicResource Language_Previous}">
            <TextBlock FontSize="16"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Style="{StaticResource SegoeAssets}"
                       Text="&#xE892;" />
        </Button>
        <!--  Play and pause  -->
        <Grid>
            <!--  Ring  -->
            <dc:ProgressRing Width="20"
                             Height="20"
                             Foreground="{DynamicResource Brush_PrimaryText}"
                             IsActive="True"
                             Visibility="{Binding IsLoadingTrack, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Grid Visibility="{Binding IsLoadingTrack, Converter={StaticResource InvertingBooleanToVisibilityConverter}}">
                <!--  Play  -->
                <Button x:Name="PlayButton"
                        Width="30"
                        Height="30"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding PlayCommand}"
                        Style="{StaticResource TransparentButton}"
                        ToolTip="{DynamicResource Language_Play}"
                        Visibility="{Binding ShowPause, Converter={StaticResource InvertingBooleanToVisibilityConverter}}">
                    <TextBlock FontSize="16"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Style="{StaticResource SegoeAssets}"
                               Text="&#xE768;" />
                </Button>
                <!--  Pause  -->
                <Button x:Name="PauseButton"
                        Width="30"
                        Height="30"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding PauseCommand}"
                        Style="{StaticResource TransparentButton}"
                        ToolTip="{DynamicResource Language_Pause}"
                        Visibility="{Binding ShowPause, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontSize="16"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Style="{StaticResource SegoeAssets}"
                               Text="&#xE769;" />
                </Button>
            </Grid>
        </Grid>
        <!--  Next  -->
        <Button x:Name="NextButton"
                Width="30"
                Height="30"
                Margin="13,0,0,0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding NextCommand}"
                Style="{StaticResource TransparentButton}"
                ToolTip="{DynamicResource Language_Next}">
            <TextBlock FontSize="16"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Style="{StaticResource SegoeAssets}"
                       Text="&#xE893;" />
        </Button>
        <!--  Shuffle  -->
        <Button x:Name="ShuffleButton"
                Width="30"
                Height="30"
                Margin="13,0,0,0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding ShuffleCommand}"
                Style="{StaticResource TransparentButton}"
                ToolTip="{DynamicResource Language_Shuffle}">
            <Grid>
                <TextBlock FontSize="16"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Style="{StaticResource SegoeAssets}"
                           Text="&#xE8B1;"
                           Visibility="{Binding Shuffle, Converter={StaticResource InvertingBooleanToVisibilityConverter}}" />
                <TextBlock FontSize="16"
                           Foreground="{DynamicResource Brush_Accent}"
                           Style="{StaticResource SegoeAssets}"
                           Text="&#xE8B1;"
                           Visibility="{Binding Shuffle, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Button>
    </StackPanel>
</UserControl>
