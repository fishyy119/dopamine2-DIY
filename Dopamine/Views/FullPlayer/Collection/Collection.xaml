<UserControl x:Class="Dopamine.Views.FullPlayer.Collection.Collection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:commonviews="clr-namespace:Dopamine.Views.Common"
             xmlns:controls="clr-namespace:Dopamine.Controls"
             xmlns:cp="clr-namespace:Dopamine.Core.Prism;assembly=Dopamine.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://www.codeplex.com/prism"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             x:Name="This"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource Brush_MainWindowBackground}"
             SizeChanged="UserControl_SizeChanged"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>
        <controls:TransitioningContentControl x:Name="CollectionRegion"
                                              Grid.Row="0"
                                              Margin="0,0,0,-6"
                                              Panel.ZIndex="0"
                                              prism:RegionManager.RegionName="{x:Static cp:RegionNames.CollectionRegion}"
                                              FadeIn="True"
                                              FadeInTimeout="0.5"
                                              SlideIn="True"
                                              SlideInFrom="{Binding SlideInFrom}"
                                              SlideInTimeout="0.5"
                                              SlideInTo="0" />
        <Grid Grid.Row="1"
              Panel.ZIndex="1"
              DockPanel.Dock="Bottom">
            <Border Height="70"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="0"
                    Background="{DynamicResource Brush_WindowHeaderBackground}" />
            <commonviews:SpectrumAnalyzerControl x:Name="SpectrumAnalyzer"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Bottom"
                                                 Panel.ZIndex="1"
                                                 SizeChanged="SpectrumAnalyzer_SizeChanged" />
            <commonviews:CollectionPlaybackControls Panel.ZIndex="2" Foreground="{DynamicResource Brush_PrimaryText}" />
        </Grid>
    </Grid>
</UserControl>
