<UserControl x:Class="Dopamine.Views.FullPlayer.Collection.CollectionSmartPlaylistEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">

    <StackPanel Margin="20">
        <TextBlock VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{DynamicResource Language_Enter_Name_For_Playlist}" />
        <TextBox Margin="0,20,0,0"
                 Style="{DynamicResource MetroTextBox}"
                 Text="{Binding EditablePlaylist.PlaylistName, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,20,0,5"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{DynamicResource Language_Create_Smart_Playlist_Where}" />
        <ListBox ItemsSource="{Binding EditablePlaylist.Rules}" Style="{StaticResource ListBoxSmartPlaylistRules}" />
        <DockPanel>
            <Button Command="{Binding AddRuleCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource RegularButtonTiny}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Style="{StaticResource SegoeAssets}"
                           Text="&#xe710;" />
            </Button>
            <ContentControl />
        </DockPanel>
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Add_If_Any_Rule_Is_Matched}"
                  IsChecked="{Binding EditablePlaylist.MatchAnyRule}"
                  Style="{StaticResource MetroCheckBox}" />
        <DockPanel Margin="0,10,0,0">
            <CheckBox Content="{DynamicResource Language_Limit_To}"
                      IsChecked="{Binding EditablePlaylist.Limit.IsEnabled}"
                      Style="{StaticResource MetroCheckBox}" />
            <TextBox Width="50"
                     Margin="10,0,10,0"
                     Style="{StaticResource MetroTextBox}"
                     Text="{Binding EditablePlaylist.Limit.Value, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox MinWidth="75"
                      ItemsSource="{Binding EditablePlaylist.LimitTypes}"
                      SelectedItem="{Binding EditablePlaylist.SelectedLimitType}"
                      Style="{StaticResource MetroComboBox}" />
            <ContentControl />
        </DockPanel>
    </StackPanel>
</UserControl>
