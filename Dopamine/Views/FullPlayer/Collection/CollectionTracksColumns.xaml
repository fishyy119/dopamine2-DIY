<UserControl x:Class="Dopamine.Views.FullPlayer.Collection.CollectionTracksColumns"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="False"
             mc:Ignorable="d">

    <StackPanel Margin="20,20,20,0">
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Rating}"
                  IsChecked="{Binding CheckBoxRatingChecked}"
                  Style="{StaticResource MetroCheckBox}"
                  Visibility="{Binding CheckBoxRatingVisible, Converter={StaticResource BooleanToCollapsedConverter}}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Love}"
                  IsChecked="{Binding CheckBoxLoveChecked}"
                  Style="{StaticResource MetroCheckBox}"
                  Visibility="{Binding CheckBoxLoveVisible, Converter={StaticResource BooleanToCollapsedConverter}}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Lyrics}"
                  IsChecked="{Binding CheckBoxLyricsChecked}"
                  Style="{StaticResource MetroCheckBox}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Artist}"
                  IsChecked="{Binding CheckBoxArtistChecked}"
                  Style="{StaticResource MetroCheckBox}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Album}"
                  IsChecked="{Binding CheckBoxAlbumChecked}"
                  Style="{StaticResource MetroCheckBox}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Genre}"
                  IsChecked="{Binding CheckBoxGenreChecked}"
                  Style="{StaticResource MetroCheckBox}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Length}"
                  IsChecked="{Binding CheckBoxLengthChecked}"
                  Style="{StaticResource MetroCheckBox}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Plays}"
                  IsChecked="{Binding CheckBoxPlayCountChecked}"
                  Style="{StaticResource MetroCheckBox}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Skips}"
                  IsChecked="{Binding CheckBoxSkipCountChecked}"
                  Style="{StaticResource MetroCheckBox}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Last_Played}"
                  IsChecked="{Binding CheckBoxDateLastPlayedChecked}"
                  Style="{StaticResource MetroCheckBox}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Date_Added}"
                  IsChecked="{Binding CheckBoxDateAddedChecked}"
                  Style="{StaticResource MetroCheckBox}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Date_Created}"
                  IsChecked="{Binding CheckBoxDateCreatedChecked}"
                  Style="{StaticResource MetroCheckBox}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Album_Artist}"
                  IsChecked="{Binding CheckBoxAlbumArtistChecked}"
                  Style="{StaticResource MetroCheckBox}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Track_Number}"
                  IsChecked="{Binding CheckBoxTrackNumberChecked}"
                  Style="{StaticResource MetroCheckBox}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Year}"
                  IsChecked="{Binding CheckBoxYearChecked}"
                  Style="{StaticResource MetroCheckBox}" />
        <CheckBox Margin="0,10,0,0"
                  Content="{DynamicResource Language_Bitrate}"
                  IsChecked="{Binding CheckBoxBitrateChecked}"
                  Style="{StaticResource MetroCheckBox}" />
    </StackPanel>
</UserControl>
