<UserControl x:Class="Dopamine.Views.FullPlayer.Collection.CollectionStaticPlaylistEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">

    <DockPanel Margin="20">
        <TextBlock VerticalAlignment="Center"
                   DockPanel.Dock="Top"
                   Foreground="{DynamicResource Brush_PrimaryText}"
                   Text="{DynamicResource Language_Enter_Name_For_Playlist}" />
        <TextBox Margin="0,20,0,0"
                 DockPanel.Dock="Top"
                 Style="{DynamicResource MetroTextBox}"
                 Text="{Binding EditablePlaylist.PlaylistName, UpdateSourceTrigger=PropertyChanged}" />
        <Border Height="10" />
    </DockPanel>
</UserControl>
