<UserControl x:Class="Dopamine.Views.FullPlayer.FullPlayerAddMusic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:commonviews="clr-namespace:Dopamine.Views.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Border Height="50"
                VerticalAlignment="Top"
                Panel.ZIndex="0"
                Background="{DynamicResource Brush_WindowHeaderBackground}" />
        <Grid Width="30"
              Height="30"
              Margin="10"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Panel.ZIndex="1">
            <Viewbox Width="30"
                     Height="30"
                     Panel.ZIndex="0">
                <Path x:Name="Droplet"
                      Data="{StaticResource Droplet}"
                      Fill="{DynamicResource Brush_Accent}" />
            </Viewbox>
            <TextBlock x:Name="Icon"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Panel.ZIndex="1"
                       FontSize="16"
                       Foreground="{DynamicResource Brush_WindowIcon}"
                       Style="{StaticResource SegoeAssets}"
                       Text="&#xE8D6;" />
        </Grid>
        <dc:Pivot Panel.ZIndex="1"
                  HeaderMargin="50,0,0,0"
                  Style="{DynamicResource MenuPivot}">
            <dc:PivotItem Header="{DynamicResource Language_Music}" Style="{StaticResource MenuPivotItem}">
                <DockPanel Margin="20">
                    <TextBlock Margin="0,5,0,0"
                               DockPanel.Dock="Top"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="{DynamicResource Language_Add_Folders_With_Your_Music}" />
                    <commonviews:CollectionFoldersSettings Margin="0,15,0,0" ShowControls="True" />
                </DockPanel>
            </dc:PivotItem>
            <dc:PivotItem Header="{DynamicResource Language_Refresh}" Style="{StaticResource MenuPivotItem}">
                <StackPanel Margin="20">
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="{DynamicResource Language_Refresh_Collection_Automatically}" />
                    <dc:Windows10ToggleSwitch x:Name="CheckBoxRefreshCollectionAutomatically"
                                              Margin="0,10,0,0"
                                              HorizontalAlignment="Left"
                                              Accent="{DynamicResource Brush_Accent}"
                                              FontSize="12"
                                              Foreground="{DynamicResource Brush_PrimaryText}"
                                              IsChecked="{Binding CheckBoxRefreshCollectionAutomaticallyChecked}"
                                              OffLabel="{DynamicResource Language_No}"
                                              OnLabel="{DynamicResource Language_Yes}" />
                    <TextBlock Margin="0,20,0,0"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="{DynamicResource Language_Ignore_Previously_Removed_Files}" />
                    <dc:Windows10ToggleSwitch x:Name="CheckBoxIgnoreRemovedFiles"
                                              Margin="0,10,0,0"
                                              HorizontalAlignment="Left"
                                              Accent="{DynamicResource Brush_Accent}"
                                              FontSize="12"
                                              Foreground="{DynamicResource Brush_PrimaryText}"
                                              IsChecked="{Binding CheckBoxIgnoreRemovedFilesChecked}"
                                              OffLabel="{DynamicResource Language_No}"
                                              OnLabel="{DynamicResource Language_Yes}" />
                    <TextBlock Margin="0,20,0,0"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="{DynamicResource Language_Refresh_Collection_Now}" />
                    <Button Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding RefreshNowCommand}"
                            Content="{DynamicResource Language_Refresh_Now}"
                            Style="{StaticResource RegularButton}" />
                </StackPanel>
            </dc:PivotItem>
            <dc:PivotItem Header="{DynamicResource Language_Album_Covers}" Style="{StaticResource MenuPivotItem}">
                <StackPanel Margin="20">
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="{DynamicResource Language_Download_Missing_Album_Covers}" />
                    <dc:Windows10ToggleSwitch x:Name="CheckBoxDownloadMissingAlbumCovers"
                                              Margin="0,10,0,0"
                                              HorizontalAlignment="Left"
                                              Accent="{DynamicResource Brush_Accent}"
                                              FontSize="12"
                                              Foreground="{DynamicResource Brush_PrimaryText}"
                                              IsChecked="{Binding CheckBoxDownloadMissingAlbumCoversChecked}"
                                              OffLabel="{DynamicResource Language_No}"
                                              OnLabel="{DynamicResource Language_Yes}" />
                    <TextBlock Margin="0,20,0,0"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="{DynamicResource Language_Reload_All_Covers_Description}" />
                    <Button Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ReloadAllCoversCommand}"
                            Content="{DynamicResource Language_Reload_All_Covers}"
                            Style="{StaticResource RegularButton}" />
                    <TextBlock Margin="0,20,0,0"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="{DynamicResource Language_Reload_Missing_Covers_Description}" />
                    <Button Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ReloadMissingCoversCommand}"
                            Content="{DynamicResource Language_Reload_Missing_Covers}"
                            Style="{StaticResource RegularButton}" />
                </StackPanel>
            </dc:PivotItem>
        </dc:Pivot>
    </Grid>
</UserControl>
