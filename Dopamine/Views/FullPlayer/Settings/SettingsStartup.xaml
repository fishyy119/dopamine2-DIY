<UserControl x:Class="Dopamine.Views.FullPlayer.Settings.SettingsStartup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <ScrollViewer Margin="5"
                  Padding="15"
                  PanningMode="Both"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Label Content="{DynamicResource Language_Updates}" Style="{StaticResource TitleLabel}" />
            <StackPanel Margin="0,5,0,0">
                <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Check_For_Updates_At_Startup}" />
                <dc:Windows10ToggleSwitch x:Name="CheckBoxCheckForUpdatesAtStartup"
                                          Margin="0,10,0,0"
                                          HorizontalAlignment="Left"
                                          Accent="{DynamicResource Brush_Accent}"
                                          FontSize="12"
                                          Foreground="{DynamicResource Brush_PrimaryText}"
                                          IsChecked="{Binding CheckBoxCheckForUpdatesAtStartupChecked}"
                                          OffLabel="{DynamicResource Language_No}"
                                          OnLabel="{DynamicResource Language_Yes}" />
                <TextBlock Margin="0,20,0,0"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Check_For_Updates_Periodically}" />
                <dc:Windows10ToggleSwitch x:Name="CheckBoxCheckForUpdatesPeriodically"
                                          Margin="0,10,0,0"
                                          HorizontalAlignment="Left"
                                          Accent="{DynamicResource Brush_Accent}"
                                          FontSize="12"
                                          Foreground="{DynamicResource Brush_PrimaryText}"
                                          IsChecked="{Binding CheckBoxCheckForUpdatesPeriodicallyChecked}"
                                          OffLabel="{DynamicResource Language_No}"
                                          OnLabel="{DynamicResource Language_Yes}" />
            </StackPanel>
            <StackPanel Margin="0,20,0,0">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPortable}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsUpdateCheckEnabled}" Value="False">
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHitTestVisible, RelativeSource={RelativeSource Self}}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Also_Check_For_Prereleases}" />
                <dc:Windows10ToggleSwitch x:Name="CheckBoxCheckForPrereleases"
                                          Margin="0,10,0,0"
                                          HorizontalAlignment="Left"
                                          Accent="{DynamicResource Brush_Accent}"
                                          FontSize="12"
                                          Foreground="{DynamicResource Brush_PrimaryText}"
                                          IsChecked="{Binding CheckBoxCheckForPrereleasesChecked}"
                                          OffLabel="{DynamicResource Language_No}"
                                          OnLabel="{DynamicResource Language_Yes}" />
            </StackPanel>
            <Label Margin="0,20,0,0"
                   Content="{DynamicResource Language_Startup_Page}"
                   Style="{StaticResource TitleLabel}" />
            <StackPanel Margin="0,5,0,0">
                <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Start_At_Last_Selected_Page}" />
                <dc:Windows10ToggleSwitch x:Name="CheckBoxStartupPage"
                                          Margin="0,10,0,0"
                                          HorizontalAlignment="Left"
                                          Accent="{DynamicResource Brush_Accent}"
                                          FontSize="12"
                                          Foreground="{DynamicResource Brush_PrimaryText}"
                                          IsChecked="{Binding CheckBoxStartupPageChecked}"
                                          OffLabel="{DynamicResource Language_No}"
                                          OnLabel="{DynamicResource Language_Yes}" />
            </StackPanel>
            <Label Margin="0,20,0,0"
                   Content="{DynamicResource Language_Last_Played}"
                   Style="{StaticResource TitleLabel}" />
            <StackPanel Margin="0,5,0,0">
                <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Remember_Last_played_Song}" />
                <dc:Windows10ToggleSwitch x:Name="CheckBoxRememberLastPlayedTrack"
                                          Margin="0,10,0,0"
                                          HorizontalAlignment="Left"
                                          Accent="{DynamicResource Brush_Accent}"
                                          FontSize="12"
                                          Foreground="{DynamicResource Brush_PrimaryText}"
                                          IsChecked="{Binding CheckBoxRememberLastPlayedTrackChecked}"
                                          OffLabel="{DynamicResource Language_No}"
                                          OnLabel="{DynamicResource Language_Yes}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
