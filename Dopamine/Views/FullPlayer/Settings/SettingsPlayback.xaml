<UserControl x:Class="Dopamine.Views.FullPlayer.Settings.SettingsPlayback"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <ScrollViewer Margin="5"
                  Padding="15"
                  PanningMode="Both"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!--  Audio device  -->
            <Label Content="{DynamicResource Language_Audio_Device}" Style="{StaticResource TitleLabel}" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="{DynamicResource Language_Choose_Audio_Device}" />
            <ComboBox x:Name="ComboBoxAudioDevice"
                      MinWidth="150"
                      Margin="0,15,0,0"
                      Padding="0"
                      HorizontalAlignment="Left"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding AudioDevices}"
                      SelectedItem="{Binding SelectedAudioDevice}"
                      Style="{StaticResource MetroComboBox}" />
            <TextBlock Margin="0,15,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="{DynamicResource Language_Latency}" />
            <ComboBox x:Name="ComboBoxLatency"
                      Width="150"
                      Margin="0,15,0,0"
                      Padding="0"
                      HorizontalAlignment="Left"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding Latencies}"
                      SelectedItem="{Binding SelectedLatency}"
                      Style="{StaticResource MetroComboBox}" />
            <!--<StackPanel Margin="0,20,0,0">
                <TextBlock Text="{DynamicResource Language_Wasapi_Event_Mode}" Foreground="{DynamicResource Brush_PrimaryText}"/>
                <dc:Windows10ToggleSwitch x:Name="CheckBoxWasapiEventMode"  Margin="0,10,0,0" HorizontalAlignment="Left" FontSize="12" OnLabel="{DynamicResource Language_Yes}" OffLabel="{DynamicResource Language_No}" Foreground="{DynamicResource Brush_PrimaryText}" Accent="{DynamicResource Brush_Accent}" IsChecked="{Binding CheckBoxWasapiEventModeChecked}"/>
            </StackPanel>-->
            <StackPanel Visibility="{Binding SupportsWindowsMediaFoundation, Converter={StaticResource BooleanToCollapsedConverter}}">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Use_All_Available_Speakers}" />
                    <dc:Windows10ToggleSwitch x:Name="CheckBoxUseAllAvailableChannels"
                                              Margin="0,10,0,0"
                                              HorizontalAlignment="Left"
                                              Accent="{DynamicResource Brush_Accent}"
                                              FontSize="12"
                                              Foreground="{DynamicResource Brush_PrimaryText}"
                                              IsChecked="{Binding CheckBoxUseAllAvailableChannelsChecked}"
                                              OffLabel="{DynamicResource Language_No}"
                                              OnLabel="{DynamicResource Language_Yes}" />
                </StackPanel>
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Wasapi_Exclusive_Mode}" />
                    <dc:Windows10ToggleSwitch x:Name="CheckBoxWasapiExclusiveMode"
                                              Margin="0,10,0,0"
                                              HorizontalAlignment="Left"
                                              Accent="{DynamicResource Brush_Accent}"
                                              FontSize="12"
                                              Foreground="{DynamicResource Brush_PrimaryText}"
                                              IsChecked="{Binding CheckBoxWasapiExclusiveModeChecked}"
                                              OffLabel="{DynamicResource Language_No}"
                                              OnLabel="{DynamicResource Language_Yes}" />
                </StackPanel>
            </StackPanel>
            <!--  Spectrum analyzer  -->
            <StackPanel Visibility="{Binding SupportsWindowsMediaFoundation, Converter={StaticResource BooleanToCollapsedConverter}}">
                <Label Margin="0,20,0,0"
                       Content="{DynamicResource Language_Spectrum_Analyzer}"
                       Style="{StaticResource TitleLabel}" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Show_Spectrum_Analyzer}" />
                <dc:Windows10ToggleSwitch x:Name="CheckBoxShowSpectrumAnalyzer"
                                          Margin="0,10,0,0"
                                          HorizontalAlignment="Left"
                                          Accent="{DynamicResource Brush_Accent}"
                                          FontSize="12"
                                          Foreground="{DynamicResource Brush_PrimaryText}"
                                          IsChecked="{Binding CheckBoxShowSpectrumAnalyzerChecked}"
                                          OffLabel="{DynamicResource Language_No}"
                                          OnLabel="{DynamicResource Language_Yes}" />
                <StackPanel Margin="0,20,0,0"
                            IsHitTestVisible="{Binding CheckBoxShowSpectrumAnalyzerChecked}"
                            Style="{StaticResource StackPanelConditionEnabled}">
                    <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Spectrum_Style}" />
                    <ComboBox x:Name="ComboBoxSpectrumStyle"
                              Width="150"
                              Margin="0,15,0,0"
                              Padding="0"
                              HorizontalAlignment="Left"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding SpectrumStyles}"
                              SelectedItem="{Binding SelectedSpectrumStyle}"
                              Style="{StaticResource MetroComboBox}" />
                </StackPanel>
            </StackPanel>
            <!--  Sleep  -->
            <Label Margin="0,20,0,0"
                   Content="{DynamicResource Language_Sleep}"
                   Style="{StaticResource TitleLabel}" />
            <StackPanel Margin="0,5,0,0">
                <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Prevent_Sleep_While_Playing}" />
                <dc:Windows10ToggleSwitch x:Name="CheckBoxPreventSleepWhilePlaying"
                                          Margin="0,10,0,0"
                                          HorizontalAlignment="Left"
                                          Accent="{DynamicResource Brush_Accent}"
                                          FontSize="12"
                                          Foreground="{DynamicResource Brush_PrimaryText}"
                                          IsChecked="{Binding CheckBoxPreventSleepWhilePlaying}"
                                          OffLabel="{DynamicResource Language_No}"
                                          OnLabel="{DynamicResource Language_Yes}" />
            </StackPanel>
            <!--  Notification  -->
            <Label Margin="0,20,0,0"
                   Content="{DynamicResource Language_Notification}"
                   Style="{StaticResource TitleLabel}" />
            <StackPanel Margin="0,5,0,0" Visibility="{Binding IsWindows10, Converter={StaticResource BooleanToCollapsedConverter}}">
                <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Enable_System_Notification}" />
                <dc:Windows10ToggleSwitch x:Name="CheckBoxEnableSystemNotification"
                                          Margin="0,10,0,0"
                                          HorizontalAlignment="Left"
                                          Accent="{DynamicResource Brush_Accent}"
                                          FontSize="12"
                                          Foreground="{DynamicResource Brush_PrimaryText}"
                                          IsChecked="{Binding CheckBoxEnableSystemNotificationChecked}"
                                          OffLabel="{DynamicResource Language_No}"
                                          OnLabel="{DynamicResource Language_Yes}" />
            </StackPanel>
            <StackPanel IsHitTestVisible="{Binding CheckBoxEnableSystemNotificationChecked, Converter={StaticResource InvertingBooleanConverter}}" Style="{StaticResource StackPanelConditionEnabled}">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Show_Notification_When_Song_Starts}" />
                    <dc:Windows10ToggleSwitch x:Name="CheckBoxShowNotificationWhenPlaying"
                                              Margin="0,10,0,0"
                                              HorizontalAlignment="Left"
                                              Accent="{DynamicResource Brush_Accent}"
                                              FontSize="12"
                                              Foreground="{DynamicResource Brush_PrimaryText}"
                                              IsChecked="{Binding CheckBoxShowNotificationWhenPlayingChecked}"
                                              OffLabel="{DynamicResource Language_No}"
                                              OnLabel="{DynamicResource Language_Yes}" />
                </StackPanel>
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Show_Notification_When_Pausing_Song}" />
                    <dc:Windows10ToggleSwitch x:Name="CheckBoxShowNotificationWhenPausing"
                                              Margin="0,10,0,0"
                                              HorizontalAlignment="Left"
                                              Accent="{DynamicResource Brush_Accent}"
                                              FontSize="12"
                                              Foreground="{DynamicResource Brush_PrimaryText}"
                                              IsChecked="{Binding CheckBoxShowNotificationWhenPausingChecked}"
                                              OffLabel="{DynamicResource Language_No}"
                                              OnLabel="{DynamicResource Language_Yes}" />
                </StackPanel>
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Show_Notification_When_Resuming_Song}" />
                    <dc:Windows10ToggleSwitch x:Name="CheckBoxShowNotificationWhenResuming"
                                              Margin="0,10,0,0"
                                              HorizontalAlignment="Left"
                                              Accent="{DynamicResource Brush_Accent}"
                                              FontSize="12"
                                              Foreground="{DynamicResource Brush_PrimaryText}"
                                              IsChecked="{Binding CheckBoxShowNotificationWhenResumingChecked}"
                                              OffLabel="{DynamicResource Language_No}"
                                              OnLabel="{DynamicResource Language_Yes}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,20,0,0"
                        IsHitTestVisible="{Binding IsNotificationEnabled}"
                        Style="{StaticResource StackPanelConditionEnabled}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Show_Notification_Only_When_Player_Not_Visible}" />
                    <dc:Windows10ToggleSwitch x:Name="CheckBoxShowNotificationOnlyWhenPlayerNotVisible"
                                              Margin="0,10,0,0"
                                              HorizontalAlignment="Left"
                                              Accent="{DynamicResource Brush_Accent}"
                                              FontSize="12"
                                              Foreground="{DynamicResource Brush_PrimaryText}"
                                              IsChecked="{Binding CheckBoxShowNotificationOnlyWhenPlayerNotVisibleChecked}"
                                              OffLabel="{DynamicResource Language_No}"
                                              OnLabel="{DynamicResource Language_Yes}" />
                </StackPanel>
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Show_Notification_Controls}" />
                    <dc:Windows10ToggleSwitch x:Name="CheckBoxShowNotificationControls"
                                              Margin="0,10,0,0"
                                              HorizontalAlignment="Left"
                                              Accent="{DynamicResource Brush_Accent}"
                                              FontSize="12"
                                              Foreground="{DynamicResource Brush_PrimaryText}"
                                              IsChecked="{Binding CheckBoxShowNotificationControlsChecked}"
                                              OffLabel="{DynamicResource Language_No}"
                                              OnLabel="{DynamicResource Language_Yes}" />
                </StackPanel>
                <TextBlock Margin="0,20,0,0"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Notification_Position}" />
                <DockPanel Margin="0,10,0,0" HorizontalAlignment="Left">
                    <ComboBox x:Name="ComboBoxNotificationPositions"
                              Width="150"
                              Padding="0"
                              HorizontalAlignment="Left"
                              VerticalContentAlignment="Center"
                              DockPanel.Dock="Left"
                              ItemsSource="{Binding NotificationPositions}"
                              SelectedItem="{Binding SelectedNotificationPosition}"
                              Style="{StaticResource MetroComboBox}" />
                    <Button Width="80"
                            Margin="10,0,0,0"
                            Command="{Binding ShowTestNotificationCommand}"
                            Content="{DynamicResource Language_Test}"
                            Style="{StaticResource RegularButton}" />
                </DockPanel>
                <TextBlock Margin="0,20,0,0"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Close_Notification_Automatically_After}" />
                <DockPanel Margin="0,10,0,0" HorizontalAlignment="Left">
                    <ComboBox x:Name="ComboBoxNotificationSeconds"
                              Width="75"
                              Padding="0"
                              HorizontalAlignment="Left"
                              VerticalContentAlignment="Center"
                              DockPanel.Dock="Left"
                              ItemsSource="{Binding NotificationSeconds}"
                              SelectedItem="{Binding SelectedNotificationSecond}"
                              Style="{StaticResource MetroComboBox}" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush_PrimaryText}"
                               Text="{DynamicResource Language_Seconds}" />
                </DockPanel>
            </StackPanel>
            <!--  End Notification  -->

            <Label Margin="0,20,0,0"
                   Content="{DynamicResource Language_Taskbar}"
                   Style="{StaticResource TitleLabel}" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="{DynamicResource Language_Show_Audio_Progress_In_Taskbar}" />
            <dc:Windows10ToggleSwitch x:Name="CheckBoxShowProgressInTaskbar"
                                      Margin="0,10,0,0"
                                      HorizontalAlignment="Left"
                                      Accent="{DynamicResource Brush_Accent}"
                                      FontSize="12"
                                      Foreground="{DynamicResource Brush_PrimaryText}"
                                      IsChecked="{Binding CheckBoxShowProgressInTaskbarChecked}"
                                      OffLabel="{DynamicResource Language_No}"
                                      OnLabel="{DynamicResource Language_Yes}" />

            <Label Margin="0,20,0,0"
                   Content="{DynamicResource Language_Shuffle}"
                   Style="{StaticResource TitleLabel}" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="{DynamicResource Language_Loop_When_Shuffle}" />
            <dc:Windows10ToggleSwitch x:Name="CheckBoxLoopWhenShuffle"
                                      Margin="0,10,0,0"
                                      HorizontalAlignment="Left"
                                      Accent="{DynamicResource Brush_Accent}"
                                      FontSize="12"
                                      Foreground="{DynamicResource Brush_PrimaryText}"
                                      IsChecked="{Binding CheckBoxLoopWhenShuffleChecked}"
                                      OffLabel="{DynamicResource Language_No}"
                                      OnLabel="{DynamicResource Language_Yes}" />

            <Label Margin="0,20,0,0"
                   Content="{DynamicResource Language_External_Control}"
                   Style="{StaticResource TitleLabel}" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="{DynamicResource Language_Enable_External_Control}" />
            <dc:Windows10ToggleSwitch x:Name="CheckBoxEnableExternalControl"
                                      Margin="0,10,0,0"
                                      HorizontalAlignment="Left"
                                      Accent="{DynamicResource Brush_Accent}"
                                      FontSize="12"
                                      Foreground="{DynamicResource Brush_PrimaryText}"
                                      IsChecked="{Binding CheckBoxEnableExternalControlChecked}"
                                      OffLabel="{DynamicResource Language_No}"
                                      OnLabel="{DynamicResource Language_Yes}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
