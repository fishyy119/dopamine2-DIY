<UserControl x:Class="Dopamine.Views.FullPlayer.Settings.SettingsAppearance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:commonviews="clr-namespace:Dopamine.Views.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pc="clr-namespace:Dopamine.Controls"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <ScrollViewer Margin="5"
                  Padding="15"
                  PanningMode="Both"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Label Content="{DynamicResource Language_Theme}" Style="{StaticResource TitleLabel}" />
            <commonviews:AppearanceTheme Margin="0,5,0,0" ShowFollowAlbumCoverColor="True" />
            <pc:IconTextButton Margin="0,15,0,0"
                               HorizontalAlignment="Left"
                               Command="{Binding OpenColorSchemesDirectoryCommand}"
                               CommandParameter="{Binding Path=ColorSchemesDirectory}"
                               Content="{DynamicResource Language_Add_More_Colors}"
                               Foreground="{DynamicResource Brush_Accent}"
                               Glyph="&#xE710;"
                               GlyphSize="13" />
            <Label Margin="0,20,0,0"
                   Content="{DynamicResource Language_Border}"
                   Style="{StaticResource TitleLabel}" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="{DynamicResource Language_Show_Window_Border}" />
            <dc:Windows10ToggleSwitch x:Name="CheckBoxShowWindowBorder"
                                      Margin="0,10,0,0"
                                      HorizontalAlignment="Left"
                                      Accent="{DynamicResource Brush_Accent}"
                                      FontSize="12"
                                      Foreground="{DynamicResource Brush_PrimaryText}"
                                      IsChecked="{Binding CheckBoxCheckBoxShowWindowBorderChecked}"
                                      OffLabel="{DynamicResource Language_No}"
                                      OnLabel="{DynamicResource Language_Yes}" />
            <Label Margin="0,20,0,0"
                   Content="{DynamicResource Language_Language}"
                   Style="{StaticResource TitleLabel}" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="{DynamicResource Language_Choose_Language}" />
            <commonviews:AppearanceLanguage Margin="0,15,0,0" />
            <StackPanel Visibility="{Binding IsWindows10, Converter={StaticResource BooleanToCollapsedConverter}}">
                <Label Margin="0,20,0,0"
                       Content="{DynamicResource Language_Transparency}"
                       Style="{StaticResource TitleLabel}" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Enable_Transparency}" />
                <dc:Windows10ToggleSwitch x:Name="CheckBoxEnableTransparency"
                                          Margin="0,10,0,0"
                                          HorizontalAlignment="Left"
                                          Accent="{DynamicResource Brush_Accent}"
                                          FontSize="12"
                                          Foreground="{DynamicResource Brush_PrimaryText}"
                                          IsChecked="{Binding CheckBoxEnableTransparencyChecked}"
                                          OffLabel="{DynamicResource Language_No}"
                                          OnLabel="{DynamicResource Language_Yes}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
