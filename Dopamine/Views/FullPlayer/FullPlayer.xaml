<UserControl x:Class="Dopamine.Views.FullPlayer.FullPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:commonviews="clr-namespace:Dopamine.Views.Common"
             xmlns:controls="clr-namespace:Dopamine.Controls"
             xmlns:cp="clr-namespace:Dopamine.Core.Prism;assembly=Dopamine.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fwc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://www.codeplex.com/prism"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             xmlns:utils="clr-namespace:Dopamine.Utils"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Border HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Panel.ZIndex="0"
                Background="{DynamicResource Brush_WindowHeaderBackground}" />
        <DockPanel Panel.ZIndex="1">
            <DockPanel DockPanel.Dock="Top">
                <!--  Window controls  -->
                <commonviews:WindowControls VerticalAlignment="Top"
                                            ButtonHeight="50"
                                            ButtonWidth="50"
                                            DockPanel.Dock="Right"
                                            ShowMaximizeRestoreButton="True" />
                <!--  Sub menu button  -->
                <controls:DropDownButton Width="48"
                                         Height="50"
                                         VerticalAlignment="Top"
                                         DockPanel.Dock="Right"
                                         Style="{StaticResource WindowDropDownButton}"
                                         ToolTip="{DynamicResource Language_Open_Menu}">
                    <fwc:SegoeIcon HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Text="&#xE700;" />
                    <controls:DropDownButton.Menu>
                        <ContextMenu>
                            <ContextMenu.Resources>
                                <utils:BindingProxy x:Key="ManageCollectionProxy" Data="{DynamicResource Language_Manage_Collection}" />
                            </ContextMenu.Resources>
                            <MenuItem Command="{Binding ManageCollectionCommand}" Header="{Binding Source={StaticResource ManageCollectionProxy}, Path=Data, Converter={StaticResource AddEllipsisConverter}}" />
                            <Separator />
                            <MenuItem Command="{Binding SetSelectedFullPlayerPageCommand}"
                                      CommandParameter="1"
                                      Header="{DynamicResource Language_Settings}" />
                            <MenuItem Command="{Binding SetSelectedFullPlayerPageCommand}"
                                      CommandParameter="2"
                                      Header="{DynamicResource Language_Information}" />
                        </ContextMenu>
                    </controls:DropDownButton.Menu>
                </controls:DropDownButton>
                <!--  Logo/Back button  -->
                <Grid Width="50"
                      Height="50"
                      VerticalAlignment="Top"
                      Background="#00000000"
                      DockPanel.Dock="Left"
                      MouseEnter="Grid_MouseEnter"
                      MouseLeave="Grid_MouseLeave">
                    <!--  Droplet  -->
                    <Viewbox Width="30"
                             Height="30"
                             Panel.ZIndex="0">
                        <Path x:Name="Droplet"
                              Data="{StaticResource Droplet}"
                              Fill="{DynamicResource Brush_Accent}" />
                    </Viewbox>
                    <!--  Headphone  -->
                    <Viewbox x:Name="HeadPhoneIcon"
                             Width="20"
                             Height="20"
                             Panel.ZIndex="1"
                             Opacity="1"
                             Visibility="{Binding ShowBackButton, Converter={StaticResource InvertingBooleanToCollapsedConverter}}">
                        <Path x:Name="HeadPhone"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{StaticResource HeadPhone}"
                              Fill="{DynamicResource Brush_WindowIcon}" />
                    </Viewbox>
                    <!--  Back button  -->
                    <Button x:Name="BackButton"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Panel.ZIndex="1"
                            Command="{Binding BackButtonCommand}"
                            Style="{StaticResource TransparentFixedButton}"
                            Visibility="{Binding ShowBackButton, Converter={StaticResource BooleanToCollapsedConverter}}">
                        <fwc:SegoeIcon x:Name="BackIcon"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="20"
                                       Foreground="{DynamicResource Brush_WindowIcon}"
                                       Text="&#xE72B;">
                            <fwc:SegoeIcon.ToolTip>
                                <TextBlock FontSize="13" Text="{DynamicResource Language_Back}" />
                            </fwc:SegoeIcon.ToolTip>
                        </fwc:SegoeIcon>
                    </Button>
                </Grid>
                <!--  Main menu  -->
                <controls:TransitioningContentControl x:Name="FullPlayerMenuRegion"
                                                      prism:RegionManager.RegionName="{x:Static cp:RegionNames.FullPlayerMenuRegion}"
                                                      FadeIn="True"
                                                      FadeInTimeout="0.75"
                                                      SlideIn="True"
                                                      SlideInFrom="{Binding SlideInFrom}"
                                                      SlideInTimeout="0.75"
                                                      SlideInTo="0" />
            </DockPanel>
            <Grid DockPanel.Dock="Top">
                <commonviews:UpdateStatus Panel.ZIndex="0" />
                <commonviews:IndexingStatus Panel.ZIndex="1" />
            </Grid>
            <controls:TransitioningContentControl x:Name="FullPlayerRegion"
                                                  prism:RegionManager.RegionName="{x:Static cp:RegionNames.FullPlayerRegion}"
                                                  FadeIn="True"
                                                  FadeInTimeout="0.5"
                                                  SlideIn="True"
                                                  SlideInFrom="{Binding SlideInFrom}"
                                                  SlideInTimeout="0.5"
                                                  SlideInTo="0" />
        </DockPanel>
    </Grid>
</UserControl>
