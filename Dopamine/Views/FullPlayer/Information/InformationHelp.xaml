<UserControl x:Class="Dopamine.Views.FullPlayer.Information.InformationHelp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pc="clr-namespace:Dopamine.Controls"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <ScrollViewer Margin="5"
                  Padding="15"
                  PanningMode="Both"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Label Content="{DynamicResource Language_File_Types}" Style="{StaticResource TitleLabel}" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="{DynamicResource Language_File_Types_Description}"
                       TextWrapping="Wrap" />
            <Separator Height="20" Background="Transparent" />
            <Label Content="{DynamicResource Language_Keyboard_Shortcuts}" Style="{StaticResource TitleLabel}" />
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Margin="0,5,0,5"
                       HorizontalAlignment="Left"
                       Content="{DynamicResource Language_Key_Plus}"
                       Style="{StaticResource NormalKey}" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Margin="30,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Increase_Volume_By_5_Percent}" />

                <pc:CombiLabel Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,5,0,5"
                               HorizontalAlignment="Left"
                               Content="{DynamicResource Language_Key_Ctrl}"
                               Content2="{StaticResource Language_Key_Plus}"
                               Style="{StaticResource Hotkey}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Margin="30,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Increase_Volume_By_1_Percent}" />

                <Label Grid.Row="2"
                       Grid.Column="0"
                       Margin="0,5,0,5"
                       HorizontalAlignment="Left"
                       Content="{DynamicResource Language_Key_Minus}"
                       Style="{StaticResource NormalKey}" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Margin="30,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Decrease_Volume_By_5_Percent}" />

                <pc:CombiLabel Grid.Row="3"
                               Grid.Column="0"
                               Margin="0,5,0,5"
                               HorizontalAlignment="Left"
                               Content="{DynamicResource Language_Key_Ctrl}"
                               Content2="{StaticResource Language_Key_Minus}"
                               Style="{StaticResource Hotkey}" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Margin="30,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Decrease_Volume_By_1_Percent}" />

                <Label Grid.Row="4"
                       Grid.Column="0"
                       Margin="0,5,0,5"
                       HorizontalAlignment="Left"
                       Content="&#xE72B;"
                       Style="{StaticResource SegoeNormalKey}" />
                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Margin="30,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Long_Jump_Backward}" />

                <pc:CombiLabel Grid.Row="5"
                               Grid.Column="0"
                               Margin="0,5,0,5"
                               HorizontalAlignment="Left"
                               Content="{DynamicResource Language_Key_Ctrl}"
                               Content2="&#xE72B;"
                               Style="{StaticResource SegoeHotkey}" />
                <TextBlock Grid.Row="5"
                           Grid.Column="1"
                           Margin="30,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Short_Jump_Backward}" />

                <Label Grid.Row="6"
                       Grid.Column="0"
                       Margin="0,5,0,5"
                       HorizontalAlignment="Left"
                       Content="&#xE72A;"
                       Style="{StaticResource SegoeNormalKey}" />
                <TextBlock Grid.Row="6"
                           Grid.Column="1"
                           Margin="30,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Long_Jump_Forward}" />

                <pc:CombiLabel Grid.Row="7"
                               Grid.Column="0"
                               Margin="0,5,0,5"
                               HorizontalAlignment="Left"
                               Content="{DynamicResource Language_Key_Ctrl}"
                               Content2="&#xE72A;"
                               Style="{StaticResource SegoeHotkey}" />
                <TextBlock Grid.Row="7"
                           Grid.Column="1"
                           Margin="30,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Short_Jump_Forward}" />

                <pc:CombiLabel Grid.Row="8"
                               Grid.Column="0"
                               Margin="0,5,0,5"
                               HorizontalAlignment="Left"
                               Content="{DynamicResource Language_Key_Ctrl}"
                               Content2="F"
                               Style="{StaticResource Hotkey}" />
                <TextBlock Grid.Row="8"
                           Grid.Column="1"
                           Margin="30,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Activate_Search_Field}" />

                <pc:CombiLabel Grid.Row="9"
                               Grid.Column="0"
                               Margin="0,5,0,5"
                               HorizontalAlignment="Left"
                               Content="{DynamicResource Language_Key_Ctrl}"
                               Content2="L"
                               Style="{StaticResource Hotkey}" />
                <TextBlock Grid.Row="9"
                           Grid.Column="1"
                           Margin="30,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Log_File}" />
            </Grid>
            <Separator Height="20" Background="Transparent" />
            <!--  Media keys  -->
            <Label Content="{DynamicResource Language_Media_Keys}" Style="{StaticResource TitleLabel}" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="{DynamicResource Language_Supported_Media_Keys}"
                       TextWrapping="Wrap" />
            <Separator Height="20" Background="Transparent" />
            <!--  Output device  -->
            <Label Content="{DynamicResource Language_Audio_Device}" Style="{StaticResource TitleLabel}" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="{DynamicResource Language_Dopamine_Uses_WASAPI}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
