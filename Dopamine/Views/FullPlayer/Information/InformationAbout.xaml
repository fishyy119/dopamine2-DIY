<UserControl x:Class="Dopamine.Views.FullPlayer.Information.InformationAbout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dopamine.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fwc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             x:Name="This"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <ScrollViewer Margin="5"
                  Padding="15"
                  PanningMode="Both"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Label Content="{DynamicResource Language_About}" Style="{StaticResource TitleLabel}" />
            <controls:FullLogo x:Name="AppName"
                               Margin="0,10,0,5"
                               VerticalAlignment="Center"
                               Accent="{DynamicResource Brush_Accent}"
                               Foreground="{DynamicResource Brush_PrimaryText}" />
            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_Version}" />
                <TextBlock Margin="0,0,5,0"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text=":" />
                <TextBlock Margin="0,0,5,0"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{Binding Package.DisplayVersion}" />
            </StackPanel>
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="{Binding Copyright}" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="Modified by fishyy119" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="This software uses libraries from the FFmpeg project under the LGPLv2.1" />
            <Button Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding ShowLicenseCommand}"
                    Content="{DynamicResource Language_License}"
                    Style="{StaticResource RegularButton}" />
            <Separator Height="20" Background="Transparent" />
            <Label Content="{DynamicResource Language_Donate}" Style="{StaticResource TitleLabel}" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{DynamicResource Brush_PrimaryText}"
                       Text="{DynamicResource Language_Do_You_Like_Dopamine}" />
            <Button Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding OpenLinkCommand}"
                    CommandParameter="{Binding DonateUrl}"
                    Style="{StaticResource RegularButtonAccent}"
                    ToolTip="{DynamicResource Language_Donate_With_PayPal}">
                <StackPanel Orientation="Horizontal">
                    <fwc:SegoeIcon VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{DynamicResource Brush_RegularButtonAccentText}"
                                   Text="&#xEB52;" />
                    <TextBlock Margin="10,0,0,0"
                               Foreground="{DynamicResource Brush_RegularButtonAccentText}"
                               Text="{DynamicResource Language_Donate}" />
                </StackPanel>
            </Button>
            <Separator Height="20" Background="Transparent" />
            <Label Content="{DynamicResource Language_Contact_Us}" Style="{StaticResource TitleLabel}" />
            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                <TextBlock Margin="0,0,0,0"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Website}" />
                <TextBlock Margin="0,0,5,0"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text=":" />
                <Button Command="{Binding OpenLinkCommand}"
                        CommandParameter="{Binding WebsiteLink}"
                        Content="{Binding WebsiteLink}"
                        Style="{StaticResource LinkButton}"
                        ToolTip="{Binding WebsiteLink}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,0,0"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text="{DynamicResource Language_Social_Networks}" />
                <TextBlock Margin="0,0,5,0"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           Text=":" />
                <Button Command="{Binding OpenLinkCommand}"
                        CommandParameter="{Binding BlueskyLink}"
                        Content="Bluesky"
                        Style="{StaticResource LinkButton}"
                        ToolTip="{Binding BlueskyLink}" />
                <Button Margin="8,0,0,0"
                        Command="{Binding OpenLinkCommand}"
                        CommandParameter="{Binding MastodonLink}"
                        Content="Mastodon"
                        Style="{StaticResource LinkButton}"
                        ToolTip="{Binding MastodonLink}" />
            </StackPanel>
            <Separator Height="20" Background="Transparent" />
            <Label Content="{DynamicResource Language_Components}" Style="{StaticResource TitleLabel}" />
            <ItemsControl Margin="0,10,0,0"
                          HorizontalContentAlignment="Center"
                          Background="Transparent"
                          BorderThickness="0"
                          ItemsSource="{Binding Components}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock HorizontalAlignment="Left"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush_PrimaryText}"
                                       Text="{Binding Name}" />
                            <TextBlock Foreground="{DynamicResource Brush_PrimaryText}"
                                       Text="{Binding Description}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding DataContext.OpenLinkCommand, ElementName=This}"
                                        CommandParameter="{Binding Url}"
                                        Content="{DynamicResource Language_Website}"
                                        Style="{StaticResource LinkButton}"
                                        ToolTip="{Binding Url}" />
                                <Button Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DataContext.OpenLinkCommand, ElementName=This}"
                                        CommandParameter="{Binding LicenseUrl}"
                                        Content="{DynamicResource Language_License}"
                                        Style="{StaticResource LinkButton}"
                                        ToolTip="{Binding LicenseUrl}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Separator Height="20" Background="Transparent" />
            <Label Content="{DynamicResource Language_Thanks}" Style="{StaticResource TitleLabel}" />
            <TextBlock Margin="0,5,0,4" TextWrapping="Wrap">
                <Run Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_About_Donated_People}" />
            </TextBlock>
            <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                <Run Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_About_Translators}" />
            </TextBlock>
            <TextBlock Margin="0,0,0,0" TextWrapping="Wrap">
                <Run Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_About_Components_Developers}" />
            </TextBlock>
            <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                <Run Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_About_Neowin_Head}" />
                <InlineUIContainer>
                    <Button Command="{Binding OpenLinkCommand}"
                            CommandParameter="http://www.neowin.net/"
                            Content="Neowin"
                            Style="{StaticResource LinkButton}"
                            ToolTip="http://www.neowin.net">
                        <Button.RenderTransform>
                            <TranslateTransform Y="4" />
                        </Button.RenderTransform>
                    </Button>
                </InlineUIContainer>
                <Run Foreground="{DynamicResource Brush_PrimaryText}" Text="{DynamicResource Language_About_Neowin_End}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
