<UserControl x:Class="Dopamine.Views.NowPlaying.NowPlaying"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:commonviews="clr-namespace:Dopamine.Views.Common"
             xmlns:cp="clr-namespace:Dopamine.Core.Prism;assembly=Dopamine.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
             xmlns:enums="clr-namespace:Dopamine.Core.Enums;assembly=Dopamine.Core"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://www.codeplex.com/prism"
             xmlns:prismMvvm="clr-namespace:Prism.Mvvm;assembly=Prism.Wpf"
             x:Name="This"
             d:DesignHeight="300"
             d:DesignWidth="300"
             prismMvvm:ViewModelLocator.AutoWireViewModel="True"
             Background="#00000000"
             MouseMove="NowPlaying_MouseMove"
             SizeChanged="NowPlaying_SizeChanged"
             mc:Ignorable="d">

    <Grid>
        <commonviews:WindowControls HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="99"
                                    ButtonHeight="29"
                                    ButtonWidth="45"
                                    ShowMaximizeRestoreButton="True" />
        <!--  Background  -->
        <Border Panel.ZIndex="0" ClipToBounds="True">
            <commonviews:BackgroundCoverArtControl x:Name="BackgroundCoverArtControl" />
        </Border>
        <Border HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Panel.ZIndex="1"
                Background="{DynamicResource Brush_NowPlayingBackground}" />
        <DockPanel Panel.ZIndex="2">
            <!--  Titlebar  -->
            <Border HorizontalAlignment="Stretch" DockPanel.Dock="Top">
                <DockPanel Height="29">
                    <Button x:Name="BackButton"
                            Width="45"
                            Height="29"
                            Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            BorderThickness="0"
                            Command="{x:Static cp:ApplicationCommands.ShowFullPlayerCommand}"
                            DockPanel.Dock="Left"
                            Style="{StaticResource WindowButtonAccent}">
                        <TextBlock x:Name="Icon"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}"
                                   Style="{StaticResource SegoeAssets}"
                                   Text="&#xE830;" />
                    </Button>
                    <FrameworkElement Visibility="Collapsed" />
                </DockPanel>
                <Border.Style>
                    <Style>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=CanShowControls, ElementName=This}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.5" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <!--  Window  -->
            <Grid>
                <!--  Background  -->
                <Border Height="70"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Panel.ZIndex="0"
                        Background="{DynamicResource Brush_WindowHeaderBackground}">
                    <Border.Style>
                        <Style>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=CanShowControls, ElementName=This}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.5" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <!--  Playback controls + spectrum  -->
                <Grid VerticalAlignment="Bottom" Panel.ZIndex="1">
                    <commonviews:SpectrumAnalyzerControl x:Name="SpectrumAnalyzer"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Bottom"
                                                         SizeChanged="SpectrumAnalyzer_SizeChanged" />
                    <commonviews:NowPlayingPlaybackControls x:Name="NowPlayingPlaybackControls">
                        <commonviews:NowPlayingPlaybackControls.Style>
                            <Style>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=CanShowControls, ElementName=This}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetProperty="Opacity">
                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.75" Storyboard.TargetProperty="Opacity">
                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </commonviews:NowPlayingPlaybackControls.Style>
                    </commonviews:NowPlayingPlaybackControls>
                </Grid>
                <!--  Content  -->
                <dc:Pivot Margin="0,0,0,80"
                          Panel.ZIndex="1"
                          AnimationType="SlideHorizontal"
                          FeatheringRadius="24"
                          HeaderVisibility="Collapsed"
                          SelectedIndex="{Binding SelectedNowPlayingPage, Converter={StaticResource EnumConverter}, ConverterParameter={x:Type enums:NowPlayingPage}}"
                          SlideFadeIn="True">
                    <dc:PivotItem>
                        <!--  Displayed when no tracks are queued  -->
                        <commonviews:NothingPlayingControl />
                    </dc:PivotItem>
                    <dc:PivotItem>
                        <!--  Displayed when tracks are queued  -->
                        <dc:SlidingContentControl x:Name="NowPlayingSubPageRegion"
                                                  Margin="100,90,100,40"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  prism:RegionManager.RegionName="{x:Static cp:RegionNames.NowPlayingSubPageRegion}"
                                                  FeatheringRadius="24"
                                                  SlideDirection="{Binding Direction}"
                                                  SlideFadeIn="True" />
                    </dc:PivotItem>
                </dc:Pivot>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
