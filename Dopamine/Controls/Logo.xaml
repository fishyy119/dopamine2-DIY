<UserControl x:Class="Dopamine.Controls.Logo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="This"
             d:DesignHeight="300"
             d:DesignWidth="300"
             mc:Ignorable="d">

    <Grid>
        <Viewbox Width="56"
                 Height="56"
                 Panel.ZIndex="0">
            <Path x:Name="Droplet"
                  Data="{StaticResource Droplet}"
                  Fill="{Binding Accent, ElementName=This}" />
        </Viewbox>
        <Viewbox Width="40"
                 Height="40"
                 Panel.ZIndex="1">
            <Path x:Name="HeadPhone"
                  Data="{StaticResource HeadPhone}"
                  Fill="White" />
        </Viewbox>
    </Grid>
</UserControl>
