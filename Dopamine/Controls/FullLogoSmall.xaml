<UserControl x:Class="Dopamine.Controls.FullLogoSmall"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:base="clr-namespace:Dopamine.Core.Base;assembly=Dopamine.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="This"
             mc:Ignorable="d">

    <StackPanel Orientation="Horizontal">
        <Grid>
            <Viewbox Width="48"
                     Height="48"
                     Panel.ZIndex="0">
                <Path x:Name="Droplet"
                      Data="{StaticResource Droplet}"
                      Fill="{Binding Accent, ElementName=This}" />
            </Viewbox>
            <Viewbox Width="32"
                     Height="32"
                     Panel.ZIndex="1">
                <Path x:Name="HeadPhone"
                      Data="{StaticResource HeadPhone}"
                      Fill="White" />
            </Viewbox>
        </Grid>
        <Label Margin="15,0,0,0"
               Padding="0"
               Content="{Binding ApplicationName, ElementName=This, Converter={StaticResource StringToLowerConverter}}"
               FontFamily="/Dopamine;component/Resources/Fonts/Monoglyceride.ttf#Monoglyceride"
               FontSize="36"
               Foreground="{Binding Foreground, ElementName=This}" />
    </StackPanel>
</UserControl>
