<dc:Windows10BorderlessWindow x:Class="Dopamine.Services.Dialog.InputDialog"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
                              Width="420"
                              Background="Transparent"
                              Loaded="Window_Loaded"
                              OverlayBackground="{DynamicResource Brush_DimBackground}"
                              ResizeMode="NoResize"
                              ShowWindowControls="False"
                              SizeToContent="Height">

    <Border Margin="-2" Background="{DynamicResource Brush_MainWindowBackground}">
        <DockPanel Margin="2">
            <Border Height="50"
                    Background="{DynamicResource Brush_WindowHeaderBackground}"
                    DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <Grid Margin="10">
                        <Viewbox Width="30"
                                 Height="30"
                                 Panel.ZIndex="0">
                            <Path x:Name="Droplet"
                                  Data="{StaticResource Droplet}"
                                  Fill="{DynamicResource Brush_Accent}" />
                        </Viewbox>
                        <TextBlock x:Name="DialogIcon"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Panel.ZIndex="1"
                                   Foreground="{DynamicResource Brush_WindowIcon}"
                                   Style="{StaticResource SegoeAssets}" />
                    </Grid>
                    <TextBlock x:Name="TextBlockTitle"
                               VerticalAlignment="Center"
                               FontSize="15"
                               Foreground="{DynamicResource Brush_PrimaryText}" />
                </StackPanel>
            </Border>
            <StackPanel x:Name="DialogContent" Margin="20">
                <TextBlock x:Name="TextBlockContent"
                           Foreground="{DynamicResource Brush_PrimaryText}"
                           TextWrapping="Wrap" />
                <TextBox x:Name="TextBoxResponse"
                         Margin="0,20,0,0"
                         Style="{StaticResource MetroTextBox}" />
                <StackPanel Margin="0,30,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button x:Name="ButtonOK"
                            Click="ButtonOK_Click"
                            IsDefault="True"
                            Style="{StaticResource RegularButtonAccent}" />
                    <Button x:Name="ButtonCancel"
                            Margin="10,0,0,0"
                            Click="ButtonCancel_Click"
                            IsCancel="True"
                            Style="{StaticResource RegularButton}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</dc:Windows10BorderlessWindow>
