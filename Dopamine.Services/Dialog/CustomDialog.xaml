<dc:Windows10BorderlessWindow x:Class="Dopamine.Services.Dialog.CustomDialog"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:dc="clr-namespace:Digimezzo.Foundation.WPF.Controls;assembly=Digimezzo.Foundation.WPF"
                              Background="Transparent"
                              OverlayBackground="{DynamicResource Brush_DimBackground}"
                              ShowWindowControls="False">

    <Border Margin="-2" Background="{DynamicResource Brush_MainWindowBackground}">
        <DockPanel Margin="2">
            <Border x:Name="TitlePanel"
                    Height="50"
                    Background="{DynamicResource Brush_WindowHeaderBackground}"
                    DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <Grid Margin="10">
                        <Viewbox Width="30"
                                 Height="30"
                                 Panel.ZIndex="0">
                            <Path x:Name="Droplet"
                                  Data="{StaticResource Droplet}"
                                  Fill="{DynamicResource Brush_Accent}" />
                        </Viewbox>
                        <TextBlock x:Name="DialogIcon"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Panel.ZIndex="1"
                                   Foreground="{DynamicResource Brush_WindowIcon}"
                                   Style="{StaticResource SegoeAssets}" />
                        <ContentControl x:Name="IconContentControl"
                                        Width="30"
                                        Height="30" />
                    </Grid>
                    <TextBlock x:Name="TextBlockTitle"
                               VerticalAlignment="Center"
                               FontSize="15"
                               Foreground="{DynamicResource Brush_PrimaryText}" />
                </StackPanel>
            </Border>
            <DockPanel x:Name="DialogContent">
                <StackPanel Margin="20"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Bottom"
                            Orientation="Horizontal">
                    <Button x:Name="ButtonOK"
                            Click="ButtonOK_Click"
                            IsDefault="True"
                            Style="{StaticResource RegularButtonAccent}" />
                    <Button x:Name="ButtonCancel"
                            Margin="10,0,0,0"
                            Click="ButtonCancel_Click"
                            IsCancel="True"
                            Style="{StaticResource RegularButton}" />
                </StackPanel>
                <ContentControl x:Name="CustomContent" />
            </DockPanel>
        </DockPanel>
    </Border>
</dc:Windows10BorderlessWindow>